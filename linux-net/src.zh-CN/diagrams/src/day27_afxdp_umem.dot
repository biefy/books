digraph afxdp_umem {
    rankdir=TB;
    labelloc=t;
    label="AF_XDP：描述符移动，字节留在原处";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC", fontsize=10];

    // XDP program (kernel)
    xdp [shape=box, style="filled,rounded", fillcolor="#dbeafe",
         label="XDP 程序（内核）\nbpf_redirect_map(&xskmap,\n   ctx->rx_queue_index, 0)"];

    subgraph cluster_kernel {
        label="内核侧";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        fill [shape=box, style="filled", fillcolor="#e9d5ff",
              label="Fill 环\n（应用程序 -> 内核：\n空帧）"];
        rx [shape=box, style="filled", fillcolor="#e9d5ff",
            label="RX 环\n（内核 -> 应用程序：\n已填充帧）"];
        tx [shape=box, style="filled", fillcolor="#e9d5ff",
            label="TX 环\n（应用程序 -> 内核：\n发送这些帧）"];
        comp [shape=box, style="filled", fillcolor="#e9d5ff",
              label="Completion 环\n（内核 -> 应用程序：\n再次可用）"];
    }

    // UMEM straddles the divide
    umem [shape=record, style="filled", fillcolor="#fef3c7",
          label="{UMEM（共享内存，由内核和应用程序共同映射）|{帧 0|帧 1|帧 2|帧 3|帧 4|...}}"];

    subgraph cluster_user {
        label="用户空间侧";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        app [shape=box, style="filled,rounded", fillcolor="#dcfce7",
             label="AF_XDP 应用程序\n在 UMEM 中原地读取帧\n（无 skb、无复制）"];
    }

    xdp -> rx [color="#16a34a", style=bold, label="将帧引导\n至 RX 环"];
    rx -> app [color="#16a34a", style=bold, label="帧索引\n（描述符）"];
    app -> fill [color="#7c3aed", style=dashed, label="回收"];
    app -> tx [color="#2563eb", style=dashed];
    comp -> app [color="#2563eb", style=dashed];

    umem -> app [style=dashed, color="#d97706", label="有效载荷留在此处", constraint=false];
    umem -> rx [style=invis];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=10,
          label="环只携带帧索引，从不携带有效载荷。\l驱动支持时可实现零拷贝：\l数据包留在 UMEM 中，只有描述符移动。\l"];
    app -> note [style=invis];
}
