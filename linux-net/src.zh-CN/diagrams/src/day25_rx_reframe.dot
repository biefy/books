digraph rx_reframe {
    rankdir=TB;
    labelloc=t;
    label="RX 重新成帧：TCP 将 TLS 记录打散到报文段切分处；tls_strp 缓冲至每条记录完整";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    // ---------- TCP byte stream as it arrives ----------
    subgraph cluster_tcp {
        label="TCP 字节流（第 17 天：没有消息边界——报文段可任意切分）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=box, style="filled", fillcolor="#fef3c7"];
        seg1 [label="报文段 1"];
        seg2 [label="报文段 2"];
        seg3 [label="报文段 3"];
        seg1 -> seg2 -> seg3 [arrowhead=none, color="#94a3b8"];
    }

    // ---------- true TLS record boundaries ----------
    subgraph cluster_recs {
        label="真实的 TLS 记录边界（与报文段不对齐）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        node [shape=record, style="filled", fillcolor="#dbeafe"];
        recA [label="{记录 A|hdr 5B|ciphertext|tag}"];
        recB [label="{记录 B|hdr 5B|ciphertext|tag}"];
    }

    // misalignment: segments map onto records crossing the cuts
    seg1 -> recA [style=dashed, color="#dc2626", label="seg1 = recA 头部"];
    seg2 -> recA [style=dashed, color="#dc2626", label="seg2 = recA 尾部 + recB 头部"];
    seg2 -> recB [style=dashed, color="#dc2626"];
    seg3 -> recB [style=dashed, color="#dc2626", label="seg3 = recB 尾部"];

    // ---------- the strparser ----------
    strp [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
          label="tls_strp（net/tls/tls_strp.c）\n1. 累积传入字节\n2. 读取 5B header -> 声明的长度\n3. 等待一条完整记录到达\n   （可能跨越多个报文段）"];
    recA -> strp [color="#7c3aed"];
    recB -> strp [color="#7c3aed"];

    decrypt [shape=box, style="filled,rounded", fillcolor="#fee2e2",
             label="AES-GCM 解密 + 验证 tag\n（每次处理一条完整记录）"];
    strp -> decrypt [style=bold, color="#16a34a", label="恰好交付\n一条完整记录"];

    plain [shape=box, style="filled,rounded", fillcolor="#fef3c7",
           label="明文 -> read()"];
    decrypt -> plain [color="#d97706"];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="与 TX 成帧互为镜像（背景知识 2）。\l仅 RX：记录大小由对端选择；TCP 将其打散。\l无法认证不完整的记录。\l（参见第 17 天的序列号标尺图。）\l"];
    decrypt -> note [style=invis];
}
