digraph neigh_resolve {
    rankdir=TB;
    labelloc=t;
    label="ip_finish_output2：将下一跳 IP 转换为 MAC";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    start [shape=box, style="filled", fillcolor="#dbeafe",
           label="ip_finish_output2\n→ neigh_output()"];

    decide [shape=diamond, style="filled", fillcolor="#e9d5ff",
            label="邻居项\n已解析？"];

    // YES branch
    fast [shape=box, style="filled", fillcolor="#dcfce7",
          label="neigh_hh_output:\n前置缓存的以太网头部\n（使用第 1 天的 NET_SKB_PAD 头部空间——\n无需重新分配）"];
    driver [shape=box, style="filled", fillcolor="#fde68a",
            label="驱动发送 → 线路"];

    // NO branch
    slow [shape=box, style="filled", fillcolor="#fee2e2",
          label="neigh_resolve_output:\n将 skb 暂存在 arp_queue\n+ 发送 ARP 请求"];
    later [shape=note, style="filled", fillcolor="#fef3c7", fontsize=9,
           label="稍后：ARP 应答到达 → 发送\l或解析超时 → 丢弃\l"];

    start -> decide;
    decide -> fast  [label="是（快速路径）", color="#16a34a", fontcolor="#16a34a"];
    decide -> slow  [label="否（慢速路径）", color="#dc2626", fontcolor="#dc2626"];
    fast -> driver [style=bold, color="#16a34a"];
    slow -> later;
    later -> driver [style=dashed, color="#94a3b8", label="解析完成时", constraint=false];
}
