digraph dst_attach {
    rankdir=TB;
    labelloc=t;
    label="路由查找构建 rtable；skb_dst_set 将其固定到 skb；dst_input 通过 dst->input 跳转";
    fontname="Noto Sans CJK SC"; fontsize=13;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC"];

    // skb
    skb [shape=record, style="filled", fillcolor="#fef3c7",
         label="struct sk_buff|...|skb-\>_skb_refdst|（指针 + 低位引用计数位）"];

    // 嵌入 dst_entry 的 rtable
    subgraph cluster_rt {
        label="struct rtable";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        rt [shape=record, style="filled", fillcolor="#dbeafe",
            label="{ <d> struct dst_entry dst|（第一个成员：rtable* == dst*） }|{ input(skb)|output(net,sk,skb) }|rt_flags / rt_type / rt_gw4 / mtu"];
    }

    skb -> rt:d [style=bold, color="#dc2626", label="skb_dst_set\n(_skb_refdst)"];

    // dst_input 分派
    di [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
        label="dst_input(skb)\n调用 skb_dst(skb)->input(skb)"];
    rt -> di [style=bold, color="#7c3aed", label="dst-\>input"];

    // 扇出目标
    subgraph cluster_targets {
        label="input() 目标（由查找过程预先设置）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=box, style="filled", fillcolor="#dcfce7"];
        local [label="ip_local_deliver\n（数据包发给本机）"];
        fwd   [label="ip_forward\n（转发流量）"];
        err   [label="ip_error\n（不可达；ICMP）", fillcolor="#fee2e2"];
    }

    di -> local [color="#16a34a"];
    di -> fwd   [color="#16a34a"];
    di -> err   [color="#dc2626"];
}
