digraph txq_fanout {
    rankdir=TB;
    labelloc=t;
    label="netdev_pick_tx：扇出到 N 个硬件 TX 队列（mq 根）";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    // CPUs / sockets feeding in
    subgraph cluster_cpu {
        label="并行发送的 CPU / 套接字";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=box, style="filled", fillcolor="#dbeafe"];
        c0 [label="CPU 0\n套接字 A"];
        c1 [label="CPU 1\n套接字 B"];
        c2 [label="CPU 2\n套接字 C"];
    }

    pick [shape=box, style="filled", fillcolor="#e9d5ff",
          label="netdev_pick_tx\n（skb->queue_mapping，否则使用流哈希：\n同一流 → 同一队列）"];

    c0 -> pick; c1 -> pick; c2 -> pick;

    // mq root + per-queue fq_codel leaves
    subgraph cluster_mq {
        label="mq 根 qdisc——每个硬件 TX 队列一个 fq_codel 叶节点";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";

        node [shape=record, style="filled", fillcolor="#fde68a"];
        t0 [label="{TX 队列 0|fq_codel}"];
        t1 [label="{TX 队列 1|fq_codel}"];
        t2 [label="{TX 队列 2|fq_codel}"];
        t3 [label="{TX 队列 N|fq_codel}"];
        t0 -> t1 -> t2 -> t3 [style=invis];
    }

    pick -> t0 [color="#7c3aed"];
    pick -> t1 [color="#7c3aed"];
    pick -> t2 [color="#7c3aed"];
    pick -> t3 [color="#7c3aed"];

    nic [shape=box, style="filled", fillcolor="#dcfce7", label="NIC（多队列）→ 线路"];
    t0 -> nic [color="#16a34a"]; t1 -> nic [color="#16a34a"];
    t2 -> nic [color="#16a34a"]; t3 -> nic [color="#16a34a"];
}
