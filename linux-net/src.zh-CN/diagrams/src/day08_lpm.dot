digraph lpm {
    rankdir=LR;
    labelloc=t;
    label="最长前缀匹配：一个地址、三条候选路由，/24 胜出";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC"];

    // 正在查找的目的地址
    dst [shape=box, style="filled,rounded", fillcolor="#fef3c7",
         label="目的地址\n10.0.0.5\n00001010.00000000.00000000.00000101"];

    // 三条候选路由
    subgraph cluster_routes {
        label="候选路由（都匹配 10.0.0.5）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=record, style="filled", fillcolor="#dbeafe"];
        r0 [label="0.0.0.0/0|prefixlen 0|匹配 0 位 — 默认路由"];
        r8 [label="10.0.0.0/8|prefixlen 8|最高 8 位 = 10"];
        r24 [label="10.0.0.0/24|prefixlen 24|最高 24 位 = 10.0.0|胜出", fillcolor="#dcfce7"];
    }

    dst -> r0 [color="#94a3b8", arrowhead=none];
    dst -> r8 [color="#94a3b8", arrowhead=none];
    dst -> r24 [style=bold, color="#16a34a", label="最长\n前缀胜出"];

    // 查找结果
    res [shape=record, style="filled", fillcolor="#e9d5ff",
         label="struct fib_result|prefix = 10.0.0.0|prefixlen = 24|nhc-\>nhc_dev = eth0|nhc-\>nhc_gw = 192.168.1.1"];

    r24 -> res [style=bold, color="#7c3aed", label="结果"];
}
