digraph dss_mapping {
    rankdir=TB;
    labelloc=t;
    label="DSS 将每条子流的本地序列号映射到连接级 DSN——两条路径上出现相同 DSN 即为重新注入";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC", fontsize=10];

    // Shared DSN ruler on top
    subgraph cluster_dsn {
        label="连接级 DSN 标尺（应用程序的字节顺序）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#7c3aed";
        dsn [shape=record, style="filled", fillcolor="#e9d5ff",
             label="{<a> DSN 0..99|<b> DSN 100..199|<c> DSN 200..299|<d> DSN 300..399}"];
    }

    // Subflow A lane
    subgraph cluster_a {
        label="子流 A——使用自身单调递增的 subflow_seq（线路上的普通 TCP 流）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        a [shape=record, style="filled", fillcolor="#dbeafe",
           label="{<x> subA_seq 0..99|<y> subA_seq 100..199|<z> subA_seq 200..299}"];
    }

    // Subflow B lane
    subgraph cluster_b {
        label="子流 B——独立的 subflow_seq（subA 的第 5000 字节与 subB 的第 5000 字节互不相关）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        b [shape=record, style="filled", fillcolor="#dbeafe",
           label="{<x> subB_seq 0..99|<y> subB_seq 100..199}"];
    }

    // DSS mapping arrows from each lane up to the DSN ruler
    a:x -> dsn:a [label="DSS {data_seq=0, subflow_seq=0, data_len=100}", color="#16a34a"];
    a:y -> dsn:b [label="DSS -> DSN 100", color="#16a34a"];
    b:x -> dsn:c [label="DSS -> DSN 200", color="#d97706"];

    // The reinjection: DSN 300..399 carried on BOTH lanes
    a:z -> dsn:d [label="DSS -> DSN 300 (subA_seq 200)", color="#dc2626", style=bold];
    b:y -> dsn:d [label="DSS -> DSN 300 (subB_seq 100)", color="#dc2626", style=bold];

    // Application delivery
    app [shape=box, style="filled,rounded", fillcolor="#dcfce7",
         label="应用程序 read()\n按顺序且仅一次接收 DSN 0、100、200、300"];
    dsn -> app [label="按 DSN 顺序交付", color="#16a34a", style=bold];

    note_reinj [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
                label="重新注入：相同字节（DSN 300..399）会同时经 A 和 B 发送，\l使用不同的 subflow_seq，但 data_seq 相同。接收端发现\l重复的 DSN 范围后，只向应用程序交付一次（去重）。\l"];
    dsn:d -> note_reinj [style=dashed, color="#dc2626", constraint=false];
}
