digraph hash_pipeline {
    rankdir=LR;
    labelloc=t;
    label="流哈希流水线：SYN 四元组 → phash → 缩放索引 → 工作进程";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    tuple [shape=record, style="filled", fillcolor="#fef3c7",
           label="SYN 四元组|saddr : sport|daddr : dport"];

    ehash [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
           label="inet_ehashfn()\n（与 ehash 表使用的键哈希相同，\n第 13 天）"];

    secret [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
            label="+ inet_ehash_secret\l   （随机，每次启动一次）\l+ net_hash_mix(net)\l   （每 netns 的 salt）\l"];

    phash [shape=box, style="filled", fillcolor="#dbeafe",
           label="u32 phash\n（= reuseport_select_sock 的\narg1）"];

    scale [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
           label="reciprocal_scale(phash, N)\n= (u64)phash * N >> 32\n乘法后移位至 [0, N)"];

    idx [shape=box, style="filled", fillcolor="#dbeafe",
         label="索引 i，范围 [0, N)"];

    subgraph cluster_socks {
        label="struct sock_reuseport.socks[]（扁平数组，O(1) 索引）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=record, style="filled", fillcolor="#dbeafe"];
        s0 [label="socks[0]"];
        s1 [label="socks[1]"];
        s2 [label="socks[2]"];
        sn [label="socks[N-1]"];
        s0 -> s1 -> s2 -> sn [style=invis];
    }

    worker [shape=box, style="filled,rounded", fillcolor="#dcfce7",
            label="选中的工作进程\n（其接受队列\n接收该连接）"];

    tuple -> ehash;
    secret -> ehash [style=dashed, color="#16a34a", constraint=false];
    ehash -> phash;
    phash -> scale;
    scale -> idx;
    idx -> s2 [label="socks[i]", color="#dc2626", style=bold];
    s2 -> worker [color="#dc2626", style=bold];

    caveat [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
            label="inet_ehash_secret 每次启动后固定 → 亲和性保持不变（同一客户端 → 同一工作进程）\l重启会重新生成 inet_ehash_secret → 整个映射重新洗牌\l不同 netns → 同一四元组对应不同映射\l"];
    scale -> caveat [style=invis];
}
