digraph bpf_dispatch {
    rankdir=TB;
    labelloc=t;
    label="reuseport_select_sock 内部的分派分支：两种 BPF 返回约定";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    ctx [shape=record, style="filled", fillcolor="#fef3c7",
         label="struct sk_reuseport_md（上下文）|data, data_end（直接读取数据包）|hash（来自背景知识 1 的 u32）|sk（组内任意成员）|migrating_sk（仅迁移时设置）"];

    fork [shape=diamond, style="filled", fillcolor="#e9d5ff",
          label="prog->type ?"];

    ctx -> fork [label="传给程序", color="#7c3aed"];

    // cBPF branch
    subgraph cluster_cbpf {
        label="cBPF — SO_ATTACH_REUSEPORT_CBPF（索引模型）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#d97706";
        runfilter [shape=box, style="filled", fillcolor="#dbeafe",
                   label="run_bpf_filter()"];
        cret [shape=box, style="filled,rounded", fillcolor="#fef3c7",
              label="程序返回值\n就是索引"];
        cidx [shape=box, style="filled", fillcolor="#dbeafe",
              label="reuse->socks[index]\n（当 index < num_socks 时）"];
        runfilter -> cret -> cidx;
    }

    // eBPF branch
    subgraph cluster_ebpf {
        label="eBPF — SO_ATTACH_REUSEPORT_EBPF（辅助函数模型）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        runsk [shape=box, style="filled", fillcolor="#dbeafe",
               label="bpf_run_sk_reuseport()"];
        helper [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
                label="辅助函数 bpf_sk_select_reuseport()\n从 REUSEPORT_SOCKARRAY / SOCKMAP\n中选择"];
        eret [shape=box, style="filled,rounded", fillcolor="#fef3c7",
              label="程序仅返回\nSK_PASS / SK_DROP"];
        runsk -> helper; runsk -> eret [style=dashed];
    }

    fork -> runfilter [label="cBPF", color="#d97706"];
    fork -> runsk [label="BPF_PROG_TYPE_SK_REUSEPORT", color="#2563eb"];

    socks [shape=box, style="filled,rounded", fillcolor="#dcfce7",
           label="两者最终都得到扁平 socks[] 数组中的索引\n→ 无论哪种方式，选择复杂度都是 O(1)"];
    cidx -> socks [color="#16a34a", style=bold];
    helper -> socks [color="#16a34a", style=bold];
}
