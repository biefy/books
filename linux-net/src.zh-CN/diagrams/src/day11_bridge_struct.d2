direction: down

title: |md
  ## 网桥结构
| {near: top-center; shape: text}

br: "struct net_bridge\n(net/bridge/br_private.h)" {
  style.fill: "#dbeafe"
  b_body: |md
    每个网桥的状态：
    - port_list（端口列表）
    - 哈希表：FDB (vid, MAC)
    - VLAN 过滤开/关
    - IGMP 侦听状态
    - MST/STP 状态
  |
}

port: "struct net_bridge_port" {
  style.fill: "#fef3c7"
  p_body: |md
    每个从接口一个：
    - dev（底层 netdev）
    - port_no, prio, flags
    - STP 状态，取值之一：
      - DISABLED, BLOCKING
      - LISTENING, LEARNING
      - FORWARDING
  |
}

setup: "设置网桥" {
  style.fill: "#dcfce7"
  s_body: |md
    - ip link add br0 type bridge
    - ip link set eth0 master br0
    - ip link set eth1 master br0
    - ip link set br0 up
  |
}

br -> port: "1..N 个端口"
port -> setup
