digraph sriov_devlink {
    rankdir=TB;
    labelloc=t;
    label="SR-IOV: one physical NIC partitioned into PF + VFs, configured via devlink";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // The physical NIC: PF + embedded switch
    subgraph cluster_nic {
        label="one physical NIC";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#7c3aed";
        pf [shape=box, style="filled", fillcolor="#e9d5ff",
            label="PF (Physical Function)\nthe full NIC"];
        esw [shape=box, style="filled", fillcolor="#fef3c7",
             label="embedded switch (switchdev mode)\nsteers traffic VFs <-> wire,\nprogrammable with tc/bridge"];
        pf -> esw [style=invis];
    }

    // The VFs
    subgraph cluster_vfs {
        label="SR-IOV virtual functions";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=box, style="filled", fillcolor="#dbeafe"];
        vf0 [label="VF0"];
        vf1 [label="VF1"];
        vfn [label="VFn"];
    }

    // VMs / containers consuming the VFs
    subgraph cluster_guests {
        label="guests (near-bare-metal NIC access)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=box, style="filled,rounded", fillcolor="#dcfce7"];
        g0 [label="VM / container 0"];
        g1 [label="VM / container 1"];
        gn [label="VM / container n"];
    }

    esw -> vf0; esw -> vf1; esw -> vfn;
    vf0 -> g0 [label="assigned"]; vf1 -> g1; vfn -> gn;

    // Host-side port representors
    subgraph cluster_rep {
        label="host-side port representors (one netdev per VF)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#16a34a";
        node [shape=box, style="filled", fillcolor="#dcfce7"];
        r0 [label="rep VF0"];
        r1 [label="rep VF1"];
        rn [label="rep VFn"];
    }

    vf0 -> r0 [style=dashed, color="#16a34a", constraint=false, label="stands in for"];
    vf1 -> r1 [style=dashed, color="#16a34a", constraint=false];
    vfn -> rn [style=dashed, color="#16a34a", constraint=false];

    // devlink as the channel
    devlink [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
             label="devlink + tc\nenumerate & configure ports,\napply policy + counters"];
    devlink -> r0 [color="#7c3aed", style=bold];
    devlink -> r1 [color="#7c3aed", style=bold];
    devlink -> rn [color="#7c3aed", style=bold];
    devlink -> esw [color="#7c3aed", style=bold, label="program switch"];

    wire [shape=box, style="filled", fillcolor="#fee2e2", label="the wire"];
    esw -> wire [style=bold, color="#dc2626"];
}
