digraph ip_proto_demux {
    rankdir=TB;
    labelloc=t;
    label="L3 protocol demux: ip_protocol_deliver_rcu indexes inet_protos[] by the IPv4 Protocol byte\n(the same pattern as Day 2's L2 EtherType table, one layer up)";
    fontname="Helvetica"; fontsize=13;
    node [fontname="Monaco", fontsize=10];

    // The two stacked tables, side by side for the "same pattern" message
    skb [shape=record, style="filled", fillcolor="#fef3c7",
         label="{IPv4 packet for local host|ip_hdr(skb)-\>protocol = N (8-bit)}"];

    // Day 2 reminder table (L2) — drawn faded to show parallelism
    subgraph cluster_l2 {
        label="Day 2: L2 demux (recap, for parallel)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=record, style="filled", fillcolor="#dbeafe"];
        l2tab [label="{ptype_base[]\nkeyed by 16-bit EtherType|ETH_P_IP → ip_rcv|ETH_P_ARP → arp_rcv|ETH_P_IPV6 → ipv6_rcv}"];
    }

    local [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
           label="ip_local_deliver_finish()\nip_protocol_deliver_rcu(net, skb, proto)\nipprot = inet_protos[protocol]"];
    skb -> local [style=bold, color="#d97706"];

    // The L3 table: flat array indexed directly by protocol byte
    subgraph cluster_l3 {
        label="L3 demux: inet_protos[256], indexed DIRECTLY by the protocol byte";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#2563eb";
        node [shape=record, style="filled", fillcolor="#dbeafe"];
        l3tab [label="{inet_protos[]|<p4>[4]  IPPROTO_IPIP|<p6>[6]  IPPROTO_TCP|<p17>[17] IPPROTO_UDP|<p41>[41] IPPROTO_IPV6|<p47>[47] IPPROTO_GRE}"];
    }
    local -> l3tab [style=bold, color="#2563eb", label="inet_protos[N]-\>handler"];

    // The handlers
    tunnel4 [shape=box, style="filled", fillcolor="#e9d5ff", label="tunnel4_rcv / tunnel64_rcv\n(net/ipv4/tunnel4.c owns slots 4 & 41)\nwalks xfrm_tunnel handler list"];
    ipip   [shape=box, style="filled", fillcolor="#dcfce7", label="ipip_rcv / 6in4\n(joins list via xfrm4_tunnel_register)"];
    tcp    [shape=box, style="filled", fillcolor="#dcfce7", label="tcp_v4_rcv"];
    udp    [shape=box, style="filled", fillcolor="#fde68a", label="udp_rcv\n(VXLAN/GENEVE ride here:\nsecond demux at encap_rcv)"];
    gre    [shape=box, style="filled", fillcolor="#dcfce7", label="gre_rcv\n(owns slot 47 directly, then\nsub-dispatch by GRE version: v0 / v1)"];

    l3tab:p4  -> tunnel4 [style=bold, color="#16a34a"];
    l3tab:p41 -> tunnel4 [color="#16a34a"];
    tunnel4   -> ipip    [style=bold, color="#7c3aed", label="2nd hop"];
    l3tab:p6  -> tcp    [color="#16a34a"];
    l3tab:p17 -> udp    [style=bold, color="#d97706"];
    l3tab:p47 -> gre    [style=bold, color="#16a34a"];

    note [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
          label="Only GRE OWNS its inet_protos[] slot directly (47).\lSlots 4 & 41 are owned by tunnel4.c's tunnel4_rcv/tunnel64_rcv, which\ldispatch to ipip_rcv / 6in4 via a 2nd-level xfrm_tunnel list.\lUDP-based tunnels (VXLAN, GENEVE) get NO slot — they ride slot 17 (UDP)\land are demuxed a second time, one layer deeper, at the UDP socket.\l"];
    udp -> note [style=invis];
}
