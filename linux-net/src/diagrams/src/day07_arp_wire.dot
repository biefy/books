digraph arp_wire {
    rankdir=TB;
    labelloc=t;
    label="ARP-over-Ethernet frame: REQUEST vs REPLY, field by field";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // Ethernet header + arphdr legend, shared layout
    legend [shape=record, style="filled", fillcolor="#e9d5ff",
            label="{ Ethernet header | { dst MAC (6) | src MAC (6) | ethertype = 0x0806 (ETH_P_ARP) } }"];

    hdr [shape=record, style="filled", fillcolor="#dbeafe",
         label="{ struct arphdr | { ar_hrd=1 (Ethernet) | ar_pro=0x0800 (IPv4) | ar_hln=6 | ar_pln=4 | ar_op } }"];

    // REQUEST row
    req [shape=record, style="filled", fillcolor="#fef3c7",
         label="{ ARPOP_REQUEST (op=1)  -- BROADCAST to ff:ff:ff:ff:ff:ff | { SHA = sender MAC | SIP = sender IP | THA = 00:00:00:00:00:00 (unknown!) | TIP = target IP being asked about } }"];

    // REPLY row
    rep [shape=record, style="filled", fillcolor="#dcfce7",
         label="{ ARPOP_REPLY (op=2)  -- UNICAST back to asker | { SHA = my MAC | SIP = my IP | THA = asker's MAC (filled in) | TIP = asker's IP } }"];

    legend -> hdr [label="frame layout", color="#94a3b8"];
    hdr -> req [label="ar_op = 1", color="#94a3b8"];
    hdr -> rep [label="ar_op = 2", color="#94a3b8"];

    grat [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="Gratuitous ARP = a REQUEST whose TIP == SIP\l(\"I now own this IP\") -- broadcast, no reply expected.\l"];
    req -> grat [style=dashed, color="#16a34a", label="if TIP==SIP"];
}
