digraph bpf_map {
    rankdir=TB;
    labelloc=t;
    label="BPF map: one kernel-resident table, two writers, durable across packets";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // userspace control plane
    subgraph cluster_user {
        label="userspace";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";
        ctrl [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
              label="control plane process\nbpf() syscall:\npopulate / read entries\n(config in, stats out)"];
    }

    // kernel side
    subgraph cluster_kernel {
        label="kernel";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";

        prog [shape=box, style="filled,rounded", fillcolor="#dbeafe",
              label="in-kernel XDP program\nbpf_redirect_map(&map, key)\nlookup on the hot path\n(no syscall)"];

        map [shape=record, style="filled", fillcolor="#dbeafe",
             label="{ BPF map (key → value table) | { key | value } | { 12 | netdev   (DEVMAP) } | { 0 | per-CPU queue (CPUMAP) } | { q3 | AF_XDP socket (XSKMAP) } }"];
    }

    ctrl -> map [color="#7c3aed", style=bold, label="bpf() syscall\n(crosses user/kernel)"];
    prog -> map [color="#16a34a", style=bold, label="lookup / update\n(in kernel)"];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="A map survives across packets, across program runs,\leven across detach/re-attach.\lThe opposite of Day 1's per-packet, ephemeral refcounts.\l"];
    map -> note [style=invis];
}
