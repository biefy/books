flowchart TD
    Frame["driver RX buffer<br/><b>does:</b> holds packet bytes<br/>before skb allocation<br/><b>why next:</b> XDP gets first<br/>policy chance<br/><b>state:</b> xdp_buff points at<br/>DMA-backed data"]
    XDP["XDP program<br/><b>does:</b> parses packet with<br/>data/data_end bounds checks<br/><b>why next:</b> return code<br/>selects buffer owner<br/><b>state:</b> packet may be<br/>modified in-place"]
    Action{"XDP action"}
    Drop["XDP_DROP<br/><b>does:</b> frees/recycles RX<br/>buffer without skb<br/><b>state:</b> stack never<br/>sees packet"]
    Tx["XDP_TX<br/><b>does:</b> sends buffer back<br/>out ingress device<br/><b>state:</b> driver owns<br/>buffer for transmit"]
    Redirect["XDP_REDIRECT<br/><b>does:</b> queues buffer to<br/>devmap/cpumap/xskmap target<br/><b>state:</b> ownership moves<br/>to redirect backend"]
    Pass["XDP_PASS<br/><b>does:</b> driver builds skb<br/>from the buffer<br/><b>why next:</b> GRO/IP/netfilter/<br/>socket need skb<br/><b>state:</b> packet enters<br/>normal RX path"]
    Stack["normal stack<br/><b>does:</b> GRO, tc ingress,<br/>Netfilter, route, transport<br/><b>state:</b> skb carries metadata<br/>through kernel stack"]

    Frame --> XDP --> Action
    Action --> Drop
    Action --> Tx
    Action --> Redirect
    Action --> Pass --> Stack

    classDef xdp fill:#fef3c7,stroke:#d97706
    classDef stack fill:#dcfce7,stroke:#16a34a
    classDef bad fill:#fee2e2,stroke:#dc2626
    class Frame,XDP,Action xdp
    class Pass,Stack stack
    class Drop bad
    class Tx,Redirect stack
