direction: down

title: |md
  ## Tunnel zoo
| {near: top-center; shape: text}

ipip: "IPIP (RFC 1853)" {
  style.fill: "#dbeafe"
  ipip_body: |md
    - IP-in-IP encapsulation
    - Outer IP hdr + inner IP packet
    - Simplest tunnel; ~20B overhead
    - net/ipv4/ipip.c
  |
}

gre: "GRE" {
  style.fill: "#fef3c7"
  gre_body: |md
    - Generic Routing Encapsulation
    - Outer IP + GRE hdr + inner pkt
    - GRE hdr carries: tag, key, seq
    - Any-over-any tunneling
    - net/ipv4/ip_gre.c
  |
}

vxlan: "VXLAN" {
  style.fill: "#dcfce7"
  vxlan_body: |md
    - Outer UDP + VXLAN hdr
      + Ethernet + inner
    - VNI (24-bit) IDs overlay net
    - Default UDP port 4789
    - Heavy use in containers
    - drivers/net/vxlan/
    - net/ipv4/udp_tunnel*
  |
}

wireguard: "WireGuard" {
  style.fill: "#dbeafe"
  wg_body: |md
    - Modern, fast VPN
    - UDP-based, fixed-format msgs
    - Crypto-routed (peer pubkey)
    - drivers/net/wireguard/
    - In-tree since 5.6 (2020)
  |
}

shared: "All tunnels are netdevs" {
  style.fill: "#fef3c7"
  sh_body: |md
    - Shows up as a virtual interface
    - (vxlan0, gre0, wg0)
    - Route through them like any other
    - xmit handler encapsulates
    - RX via UDP socket or protocol
      handler that decaps
  |
}

ipip -> gre -> vxlan -> wireguard -> shared
