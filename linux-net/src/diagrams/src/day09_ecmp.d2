direction: right

title: |md
  ## ECMP and multipath
| {near: top-center; shape: text}

setup: "Setup" {
  style.fill: "#dbeafe"
  s_body: |md
    ip route add default \
      nexthop via 192.168.1.1 weight 1 \
      nexthop via 192.168.2.1 weight 1
  |
}

select: "Per-flow selection" {
  style.fill: "#fef3c7"
  sel_body: |md
    For each new flow, kernel hashes
    (src_ip, dst_ip, src_port, dst_port, proto)
    and selects a nexthop.

    Same flow → same nexthop (no reordering).
    Different flows → spread across nexthops.

    Hash function: jhash, sysctl
    `net.ipv4.fib_multipath_hash_policy`:
    - 0: L3 only (src+dst IP)
    - 1: L4 (5-tuple)
    - 2: inner L3 (for tunneled traffic)
  |
}

resilient: "Resilient hashing" {
  style.fill: "#dcfce7"
  rh_body: |md
    Default ECMP: removing one nexthop
    re-hashes ALL flows → reordering

    Resilient nexthop groups (newer):
    nexthop add id 1 group 10/20 type resilient
    Removing a nexthop only affects flows
    that were using it.
  |
}

setup -> select -> resilient
