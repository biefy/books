direction: down

title: |md
  ## Ethernet on RX
| {near: top-center; shape: text}

driver: "Driver receives bytes,\nsets skb->len to wire length" {style.fill: "#dbeafe"}

ett: "eth_type_trans(skb, dev)\nnet/ethernet/eth.c:155" {
  style.fill: "#fef3c7"
  e_body: |md
    Steps:
    1. Set `skb->mac_header = 0`
    2. Read `struct ethhdr *eth = (struct ethhdr *)skb->data`
    3. Determine pkt_type:
       - PACKET_BROADCAST (FF:FF:FF:FF:FF:FF dst)
       - PACKET_MULTICAST (group MAC)
       - PACKET_HOST (matches dev->dev_addr)
       - PACKET_OTHERHOST (someone else's MAC)
    4. `skb_pull(skb, ETH_HLEN)` — advance data 14 bytes
    5. Return `eth->h_proto`
  |
}

after: "skb is now positioned at the L3 header.\nskb->protocol = ETH_P_IP / ETH_P_IPV6 / ETH_P_8021Q / ..." {style.fill: "#dcfce7"}

driver -> ett -> after
