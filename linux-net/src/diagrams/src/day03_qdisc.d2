direction: down

title: |md
  ## Qdisc: traffic control on egress
| {near: top-center; shape: text}

enqueue: "skb arrives at dev_queue_xmit" {
  style.fill: "#dbeafe"
  e_body: |md
    __dev_queue_xmit(skb, NULL):
    1. Pick TX queue
       (RPS/aRFS/symmetric)
    2. Lookup root qdisc on txq
    3. q->enqueue(skb, q,
       &to_free): FIFO, RR,
       hierarchy, ...
  |
}

run: "qdisc_run / __qdisc_run" {
  style.fill: "#fef3c7"
  r_body: |md
    The qdisc 'pump':
    ```
    while (q->dequeue)
      sch_direct_xmit()
      # -> start_xmit
    ```
    In ctx (sendmsg) or
    softirq, backlog:
    NET_TX_SOFTIRQ.
  |
}

drv: "Driver ndo_start_xmit" {
  style.fill: "#dcfce7"
  d_body: |md
    netdev_start_xmit(skb, dev, txq):
    - dev->netdev_ops
        ->ndo_start_xmit()
    - Builds DMA descriptor
    - Submits to NIC TX ring
    - Returns NETDEV_TX_OK/BUSY
  |
}

types: "Common qdisc types\n(/proc/net/psched, tc qdisc)" {
  style.fill: "#fef3c7"
  t_body: |md
    - pfifo_fast (old default)
    - fq_codel (default 4.12+)
    - fq (BBR-friendly, pacing)
    - htb, hfsc (hierarchical)
    - mq (multi-queue wrapper)
    - clsact (BPF hook scaffold)
  |
}

enqueue -> run -> drv
drv -> types {style.stroke-dash: 4}
