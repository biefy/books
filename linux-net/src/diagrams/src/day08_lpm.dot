digraph lpm {
    rankdir=LR;
    labelloc=t;
    label="Longest-prefix-match: one address, three candidate routes, the /24 wins";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // The destination address being looked up
    dst [shape=box, style="filled,rounded", fillcolor="#fef3c7",
         label="destination\n10.0.0.5\n00001010.00000000.00000000.00000101"];

    // The three candidate routes
    subgraph cluster_routes {
        label="candidate routes (all match 10.0.0.5)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=record, style="filled", fillcolor="#dbeafe"];
        r0 [label="0.0.0.0/0|prefixlen 0|matches 0 bits — default"];
        r8 [label="10.0.0.0/8|prefixlen 8|top 8 bits = 10"];
        r24 [label="10.0.0.0/24|prefixlen 24|top 24 bits = 10.0.0|WINNER", fillcolor="#dcfce7"];
    }

    dst -> r0 [color="#94a3b8", arrowhead=none];
    dst -> r8 [color="#94a3b8", arrowhead=none];
    dst -> r24 [style=bold, color="#16a34a", label="longest\nprefix wins"];

    // The lookup result
    res [shape=record, style="filled", fillcolor="#e9d5ff",
         label="struct fib_result|prefix = 10.0.0.0|prefixlen = 24|nhc-\>nhc_dev = eth0|nhc-\>nhc_gw = 192.168.1.1"];

    r24 -> res [style=bold, color="#7c3aed", label="result"];
}
