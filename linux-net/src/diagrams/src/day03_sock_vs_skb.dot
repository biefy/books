digraph sock_vs_skb {
    rankdir=LR;
    labelloc=t;
    label="struct sock owns the chain — sk_buff is just one link";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // The long-lived connection object
    sock [shape=record, style="filled", fillcolor="#dbeafe",
          label="{struct sock|peer addr + route|seq numbers|snd_cwnd / snd_wnd|sk_wmem_queued / sk_sndbuf}"];

    // The queue of skbs hanging off it
    subgraph cluster_wq {
        label="sk_write_queue (sk_buff_head: doubly-linked list of skbs)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#94a3b8";
        node [shape=box, style="filled", fillcolor="#fef3c7"];
        s0 [label="skb 0\n[bytes]"];
        s1 [label="skb 1\n[bytes]"];
        s2 [label="skb 2\n[bytes]"];
        s3 [label="skb 3\n[bytes]"];
        s0 -> s1 -> s2 -> s3 [color="#94a3b8", dir=both, arrowhead=normal, arrowtail=normal];
    }

    sock -> s0 [style=bold, color="#2563eb", label="owns head"];

    drain [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
           label="tcp_sendmsg appends at the TAIL\ltcp_write_xmit drains from the HEAD\l"];
    s3 -> drain [style=invis];

    note [shape=note, style="filled", fillcolor="#e9d5ff", fontsize=10,
          label="sk_buff = ONE packet (Day 1)\lstruct sock = owns the WHOLE chain\l"];
    sock -> note [style=invis];
}
