direction: down

title: |md
  ## io_uring socket ops
| {near: top-center; shape: text}

basic: "Basic ops" {
  style.fill: "#dbeafe"
  b_body: |md
    SQE (Submit Q Entry) → kernel  
    CQE (Completion Q Entry) → user

    IORING_OP_ ops:
    - RECV / SEND
    - RECVMSG / SENDMSG
    - ACCEPT
    - CONNECT
    - CLOSE
  |
}

advanced: "Modern features" {
  style.fill: "#dcfce7"
  a_body: |md
    RECVMSG_MULTISHOT (5.18+)  
    one submit, many CQEs

    SEND_ZC / SENDMSG_ZC (6.0+)  
    zero-copy (ZC) send

    Provided buffers (5.19+)  
    kernel picks buf at recv

    Registered buffers (5.0+)  
    pre-pinned, zero-copy
  |
}

vs: "vs epoll" {
  style.fill: "#fef3c7"
  v_body: |md
    epoll: 'tell me when ready,  
    I'll syscall'

    io_uring: 'do this for me,  
    tell me when done'

    io_uring batches better;  
    lower syscall rate at  
    high QPS. epoll simpler.
  |
}

basic -> advanced -> vs
