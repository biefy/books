direction: right

title: |md
  ## Multiple FIB tables
| {near: top-center; shape: text}

main: "main (id 254)" {
  style.fill: "#dbeafe"
  m_body: |md
    Default destination for `ip route add`.
    Most user-added routes land here.
  |
}

local: "local (id 255)" {
  style.fill: "#fef3c7"
  l_body: |md
    Routes to local addresses (the IPs
    on this host's interfaces).
    `ip route show table local` shows them.
    Maintained by the kernel automatically.
  |
}

default: "default (id 253)" {
  style.fill: "#dcfce7"
  d_body: |md
    Lowest priority; rarely used directly.
  |
}

custom: "custom tables (1..252)" {
  style.fill: "#dbeafe"
  c_body: |md
    Created via `ip route add ... table 100`.
    Selected via fib_rules (Day 9).

    Use case: source-routing,
    per-VPN routing, multi-tenant.
  |
}

rules: "fib_rules: which table?" {
  style.fill: "#fef3c7"
  ru_body: |md
    Default rules:
      0: from all lookup local
      32766: from all lookup main
      32767: from all lookup default

    Custom rules can route based on
    src IP, fwmark, OIF, IIF, etc.
  |
}

main -> rules
local -> rules
default -> rules
custom -> rules
