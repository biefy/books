direction: down

title: |md
  ## Multiple FIB tables
| {near: top-center; shape: text}

rules: "fib_rules: which table first?" {
  style.fill: "#fef3c7"
  ru_body: |md
    - **Does:** walks rules in
    - priority order.
    - **Why next:** first matching
    - rule picks one FIB table.
    - **State:** lookup has a table ID.
    - Defaults:
    - 0: lookup local
    - 32766: lookup main
    - 32767: lookup default
  |
}

local: "local (id 255)" {
  style.fill: "#fef3c7"
  l_body: |md
    - **Does:** matches this
    - host's own addresses.
    - **Why first:** local delivery
    - must win over forwarding.
    - **Owner:** kernel-maintained.
  |
}

main: "main (id 254)" {
  style.fill: "#dbeafe"
  m_body: |md
    - **Does:** ordinary
    - user/admin routes.
    - **Why next:** where
    - `ip route add` lands
    - unless a table is named.
  |
}

default: "default (id 253)" {
  style.fill: "#dcfce7"
  d_body: |md
    - **Does:** final fallback table.
    - **Why last:** historical
    - compatibility; rarely
    - populated on modern hosts.
  |
}

custom: "custom tables (u32 IDs)" {
  style.fill: "#dbeafe"
  c_body: |md
    - **Does:** separate FIBs
    - for policy routing.
    - **Why selected:** source IP,
    - fwmark, iif/oif, UID, ports
    - matched a rule.
    - **Note:** examples use 100/200,
    - but table IDs are not
    - capped at 252.
  |
}

rules -> local: "priority 0"
local -> main: "fallback"
main -> default: "last default rule"
default -> custom: "custom rule match"
