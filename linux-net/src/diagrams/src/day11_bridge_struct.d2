direction: down

title: |md
  ## Bridge structure
| {near: top-center; shape: text}

br: "struct net_bridge\n(net/bridge/br_private.h)" {
  style.fill: "#dbeafe"
  b_body: |md
    Per-bridge state:
    - port_list (list of ports)
    - hash table: FDB (vid, MAC)
    - VLAN filtering on/off
    - IGMP snooping state
    - MST/STP state
  |
}

port: "struct net_bridge_port" {
  style.fill: "#fef3c7"
  p_body: |md
    One per slave iface:
    - dev (underlying netdev)
    - port_no, prio, flags
    - STP state, one of:
      - DISABLED, BLOCKING
      - LISTENING, LEARNING
      - FORWARDING
  |
}

setup: "Set up a bridge" {
  style.fill: "#dcfce7"
  s_body: |md
    - ip link add br0 type bridge
    - ip link set eth0 master br0
    - ip link set eth1 master br0
    - ip link set br0 up
  |
}

br -> port: "1..N ports"
port -> setup
