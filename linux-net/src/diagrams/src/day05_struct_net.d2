direction: down

title: |md
  ## struct net — one per netns
| {near: top-center; shape: text}

netns: "struct net (net_namespace.h:62)" {
  style.fill: "#dbeafe"
  n_body: |md
    One per network namespace.
    Holds **everything** per-ns:

    - dev_base_head — net_devices
    - rtnl — netlink socket
    - ipv4.fib_main — routes
    - ipv4.tcp_death_row — timewait
    - ipv4.fib_notifier_ops
    - ipv6.fib6_main_tbl
    - nft_state — nftables rules
    - ct.count, ct.htable
    - sysctls — per-ns table
    - proc_net — /proc/net
    - ns — nsfs handle
  |
}

usage: "Per-call dispatch" {
  style.fill: "#fef3c7"
  u_body: |md
    Funcs take `struct net *net`
    first. Examples:

    - ip_rcv() calls dev_net(dev)
      for the dev's ns.
    - fib_lookup(net, &fl, &res)
      — per-ns result.
    - nf_hook(proto, hook, net)
      — chains per-ns.

    Net is a parameter, not a
    global.
  |
}

shared: "What's NOT per-ns" {
  style.fill: "#fee2e2"
  s_body: |md
    - Hardware (the NICs)
    - Slab caches
      (skbuff_head_cache)
    - Route cache slabs
    - Most BPF maps
      (unless per-ns)
    - kernel timers
    - process scheduler

    A NIC starts in init_net;
    move it with:
    ip link set IF netns NS
  |
}

netns -> usage
usage -> shared
