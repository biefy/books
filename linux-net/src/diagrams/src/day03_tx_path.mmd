flowchart LR
    App["<b>1. userspace → socket</b><br/>send/write resolves fd to socket<br/><b>handoff:</b> TCP sendmsg owns stream bytes<br/><b>state:</b> locked sock + msg iterator"]

    TCP["<b>2. TCP write queue</b><br/>copy/zerocopy user bytes into skbs<br/><b>handoff:</b> push policy and windows permit send<br/><b>state:</b> skbs have sequence numbers"]

    Segment["<b>3. TCP transmit decision</b><br/>apply cwnd, rwnd, Nagle, pacing, SACK/loss<br/><b>handoff:</b> chosen segment may enter IP<br/><b>state:</b> TCP header/checksum metadata ready"]

    IP["<b>4. IP + Netfilter</b><br/>route lookup, LOCAL_OUT, POST_ROUTING, NAT/filter<br/><b>handoff:</b> accepted skb has dst and nexthop<br/><b>state:</b> rtable, marks, MTU, gateway known"]

    L2["<b>5. neighbour + device queue</b><br/>resolve ARP/ND and build L2 header<br/><b>handoff:</b> complete frame can be scheduled<br/><b>state:</b> output device + L2 destination"]

    Dev["<b>6. qdisc → driver → NIC</b><br/>tcx/tc, shaping, dequeue, DMA descriptors<br/><b>handoff:</b> NIC doorbell owns TX descriptors<br/><b>state:</b> bytes leave; skb freed after completion"]

    App --> TCP --> Segment --> IP --> L2 --> Dev

    classDef us fill:#dbeafe,stroke:#2563eb,stroke-width:2px
    classDef tcp fill:#fef3c7,stroke:#d97706,stroke-width:2px
    classDef ip fill:#dcfce7,stroke:#16a34a,stroke-width:2px
    classDef dev fill:#e0e7ff,stroke:#6366f1,stroke-width:2px
    class App us
    class TCP,Segment tcp
    class IP,L2 ip
    class Dev dev
