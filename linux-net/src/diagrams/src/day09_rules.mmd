flowchart TD
    Pkt["packet enters"]
    Lookup["fib_lookup(net, &flowi4, &res)"]
    R0["rule 0: from all<br/>lookup local"]
    R1["rule 32766: from all<br/>lookup main"]
    R2["rule 32767: from all<br/>lookup default"]

    Custom["custom rule:<br/>'from 10.99.0.0/24 lookup 100'<br/>added by user"]

    Match{Match?}
