flowchart TD
    Key["<b>packet / flow key</b><br/>src, dst, mark, TOS,<br/>input/output interface"]

    Scan["<b>priority-ordered rule scan</b><br/>lowest priority number first<br/>stop when an action returns a route"]

    Rule["<b>each rule = predicate + target</b><br/><b>predicate:</b> from 10.99.0.0/24<br/><b>target:</b> lookup table 100"]

    Table["<b>selected routing table</b><br/>longest-prefix lookup in local,<br/>main, default, or custom table"]

    Result["<b>fib_result</b><br/>route type, nexthop, scope,<br/>metrics, preferred source"]

    Miss["<b>no match / no route</b><br/>continue to next rule;<br/>if none produce a route, fail lookup"]

    Key --> Scan --> Rule --> Table --> Result
    Table -. lookup miss .-> Miss -. next rule .-> Scan

    Defaults["<b>default rule order</b><br/>0 → local table<br/>32766 → main table<br/>32767 → default table"]
    Scan -. typical built-ins .-> Defaults

    classDef key fill:#dbeafe,stroke:#2563eb,stroke-width:2px
    classDef rule fill:#fef3c7,stroke:#d97706,stroke-width:2px
    classDef out fill:#dcfce7,stroke:#16a34a,stroke-width:2px
    classDef miss fill:#fee2e2,stroke:#dc2626,stroke-width:2px
    class Key key
    class Scan,Rule,Defaults rule
    class Table,Result out
    class Miss miss
