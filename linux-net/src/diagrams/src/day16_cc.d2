direction: down

title: |md
  ## TCP CC framework
| {near: top-center; shape: text}

iface: "struct tcp_congestion_ops" {
  style.fill: "#dbeafe"
  i_body: |md
    Vtable each CC algorithm implements:
    - init(sk)              — set up per-connection state
    - ssthresh(sk)          — slow-start threshold
    - cong_avoid(sk, ack, acked) — every ACK
    - set_state(sk, new_state) — fast-retrans, recovery
    - cwnd_event(sk, ev)    — events
    - in_ack_event(sk, flags)
    - pkts_acked(sk, sample) — RTT/ECN feedback

    Defined in include/net/tcp.h.
  |
}

algos: "Algorithms in tree" {
  style.fill: "#fef3c7"
  a_body: |md
    - tcp_cubic (default since 2.6.18)
    - tcp_bbr (Google's BBR, 4.9+)
    - tcp_reno (classic AIMD)
    - tcp_vegas (RTT-based)
    - tcp_dctcp (datacenter, ECN-based)
    - tcp_bic, tcp_westwood, tcp_yeah, ...

    Each is a kernel module:
    /lib/modules/KERNELVER/kernel/net/ipv4/tcp_*.ko
  |
}

sel: "Selection" {
  style.fill: "#dcfce7"
  s_body: |md
    Per-system default:
      sysctl net.ipv4.tcp_congestion_control

    Per-connection:
      setsockopt(sk, SOL_TCP, TCP_CONGESTION,
                 "bbr", 3);

    See available:
      sysctl net.ipv4.tcp_available_congestion_control
  |
}

iface -> algos
algos -> sel
