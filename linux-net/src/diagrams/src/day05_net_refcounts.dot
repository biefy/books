digraph net_refcounts {
    rankdir=TB;
    labelloc=t;
    label="struct net: two refcounts — holders decide when the stack dies, passive when memory frees";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // The struct net
    net [shape=record, style="filled", fillcolor="#dbeafe",
         label="struct net|<h>ns_common.__ns_ref (holders)|<p>passive (memory guard)"];

    // Holders feeding in
    subgraph cluster_holders {
        label="holders take get_net() references";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#2563eb";
        node [shape=box, style="filled", fillcolor="#fef3c7"];
        sock [label="non-kernel socket in netns"];
        nsproxy [label="task's nsproxy->net_ns"];
    }
    sock -> net:h [label="get_net", fontsize=9, color="#d97706"];
    nsproxy -> net:h [label="get_net", fontsize=9, color="#d97706"];

    // A netdev does NOT hold a reference — nd_net is a plain pointer
    netdev [shape=box, style="filled", fillcolor="#fef3c7", label="netdev in netns"];
    netdev -> net:h [style=dashed, color="#94a3b8", fontsize=9,
                     label="dev_net_set(): plain pointer, NOT a holder"];

    // Holder path to zero
    putnet [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
            label="put_net(): drops count\nreaches 0 → __put_net()"];
    queue [shape=box, style="filled,rounded", fillcolor="#dcfce7",
           label="queue_work(netns_wq)\n(process context, may sleep)"];
    cleanup [shape=box, style="filled,rounded", fillcolor="#dcfce7",
             label="cleanup_net()\nruns pernet ops->exit\n(flush conntrack, close socks)"];

    net:h -> putnet [style=bold, color="#16a34a", label="holders → 0"];
    putnet -> queue [style=bold, color="#16a34a"];
    queue -> cleanup [style=bold, color="#16a34a"];

    // Passive path
    passive [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
             label="net_passive_dec()\nreaches 0 → kfree(net->gen)\nkmem_cache_free(struct net)"];
    net:p -> passive [style=bold, color="#7c3aed", label="passive → 0\n(after stack teardown)"];

    // ip netns delete
    delete [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
            label="ip netns delete red:\lunlinks ONLY the nsfs name\l(/var/run/netns/red bind-mount).\lDoes NOT touch the holders arrow —\lif any holder remains, count never\lhits 0, cleanup_net never fires,\lthe struct net persists invisibly.\l"];

    nsfs [shape=box, style="filled", fillcolor="#fee2e2",
          label="/var/run/netns/red\n(nsfs name link)"];
    nsfs -> net:h [style=dashed, color="#94a3b8", label="names (not a holder)", fontsize=9];
    delete -> nsfs [label="cuts X", color="#dc2626", style=bold, fontsize=9];
}
