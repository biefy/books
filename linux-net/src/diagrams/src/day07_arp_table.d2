direction: right

title: |md
  ## ARP table (arp_tbl) layout
| {near: top-center; shape: text}

table: "struct neigh_table arp_tbl\n(net/ipv4/arp.c:152)" {
  style.fill: "#dbeafe"
  t_body: |md
    Hash table of neighbour entries:
    - Key: IP address + dev pointer
    - Value: struct neighbour (MAC + state)

    Memory accounting:
    - net.ipv4.neigh.default.gc_thresh1 (low water mark)
    - gc_thresh2 (soft limit)
    - gc_thresh3 (hard limit; refuse new entries)

    Default values: 128 / 512 / 1024.
    Heavy-traffic systems often raise.
  |
}

operations: "Operations" {
  style.fill: "#fef3c7"
  o_body: |md
    - neigh_lookup(arp_tbl, &ip, dev)
       returns struct neighbour * (refcounted)

    - neigh_create()
       inserts a new INCOMPLETE entry,
       triggers ARP request

    - neigh_update()
       on ARP reply, updates HA + state

    - neigh_event_send()
       per-skb path; queues if not yet
       resolved

    - garbage collection (timer-driven)
       reclaims old entries
  |
}

userspace: "Inspect/manipulate" {
  style.fill: "#dcfce7"
  u_body: |md
    ip neigh show
    ip neigh add 10.0.0.1 lladdr aa:bb:cc... dev eth0
    ip neigh flush all

    /proc/net/arp (legacy view)
    /proc/sys/net/ipv4/neigh/eth0/* (per-iface tunables)
  |
}

table -> operations
operations -> userspace
