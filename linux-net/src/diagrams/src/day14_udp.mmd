flowchart LR
    Send["sendmsg(fd, ...)"]
    Sock["sock_sendmsg → udp_sendmsg<br/>net/ipv4/udp.c"]
    Build["build IP+UDP headers"]
    Out["ip_send_skb → ip_local_out → ..."]

    Wire["wire"]

    UdpRcv["udp_rcv<br/>net/ipv4/udp.c"]
    Lookup["__udp4_lib_lookup<br/>(2-tuple hash: dst port)"]
    Found{Listener?}
    Drop["icmp dest_unreach"]
    Queue["sk_receive_queue.tail"]
    Wake["sk->sk_data_ready(sk)<br/>wakes recvmsg waiter"]

    App["recvmsg(fd, ...)"]
    Read["read from sk_receive_queue"]
    User["copy to user buffer"]

    Send --> Sock --> Build --> Out --> Wire
    Wire --> UdpRcv --> Lookup --> Found
    Found -->|no| Drop
    Found -->|yes| Queue --> Wake
    App --> Read --> User
    Wake -.- App

    classDef ok fill:#dcfce7,stroke:#16a34a
    classDef bad fill:#fee2e2,stroke:#dc2626
    class Wake,User ok
    class Drop bad
