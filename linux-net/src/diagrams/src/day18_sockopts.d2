direction: down

title: |md
  ## Sockopts: per-socket tuning knobs
| {near: top-center; shape: text}

generic: "Generic (SOL_SOCKET)" {
  style.fill: "#dbeafe"
  g_body: "- SO_RCVBUF / SO_SNDBUF (buffers)\n- SO_REUSEADDR / SO_REUSEPORT\n- SO_KEEPALIVE\n- SO_LINGER\n- SO_BINDTODEVICE\n- SO_PRIORITY (for tc/qdisc)\n- SO_MARK (set fwmark on tx)"
}

ip: "IP (SOL_IP / SOL_IPV6)" {
  style.fill: "#fef3c7"
  ip_body: "- IP_TOS, IP_TTL\n- IP_MULTICAST_*\n- IP_FREEBIND\n- IP_PKTINFO (recv aux info)\n- IP_TRANSPARENT (TPROXY)"
}

tcp: "TCP (SOL_TCP)" {
  style.fill: "#dcfce7"
  tcp_body: "- TCP_NODELAY (disable Nagle)\n- TCP_CORK (batch sends)\n- TCP_QUICKACK\n- TCP_CONGESTION (algorithm name)\n- TCP_FASTOPEN\n- TCP_USER_TIMEOUT\n- TCP_INFO (read tcp stats)\n- TCP_TX_DELAY (BBR pacing tuning)"
}

bpf: "BPF can set most via sock_ops" {
  style.fill: "#fef3c7"
  b_body: "bpf_setsockopt(skops, SOL_TCP,\n               TCP_CONGESTION, \"bbr\", 3);\nLets per-cgroup or per-flow policies\noverride application defaults."
}

generic -> ip -> tcp -> bpf
