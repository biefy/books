direction: down

title: |md
  ## Common qdiscs
| {near: top-center; shape: text}

pfifo: "pfifo_fast" {
  style.fill: "#fef3c7"
  p_body: |md
    Default in older kernels.

    Three priority bands
    (interactive, bulk, low).

    Simple drop-tail FIFO per band.
  |
}

fq_codel: "fq_codel" {
  style.fill: "#dcfce7"
  f_body: |md
    Default since 4.12.
    Combines:
    - Stochastic Fair Queueing
      (per-flow)
    - CoDel (controlled delay) AQM

    Solves bufferbloat in most cases.
    Source: sch_fq_codel.c
  |
}

fq: "fq" {
  style.fill: "#dbeafe"
  fq_body: |md
    Fair Queueing with pacing.

    Required for BBR
    (paces to estimated bw).

    Source: sch_fq.c
  |
}

htb: "htb / hfsc / cake" {
  style.fill: "#fef3c7"
  h_body: |md
    Hierarchical token bucket /
    fair-share.

    Configurable rate limits
    per class.

    cake: turnkey "good
    defaults" QoS.
  |
}

clsact: "clsact" {
  style.fill: "#dbeafe"
  c_body: |md
    Hook-only qdisc;
    no queueing logic.

    Provides ingress/egress slots
    for tc-bpf / tcx attach.

    Source: sch_ingress.c
  |
}

ctrl: "Manage with: tc qdisc" {
  style.fill: "#fef3c7"
  ctrl_body: |md
    ```
    tc qdisc show dev eth0
    tc qdisc replace \
      dev eth0 root fq
    tc qdisc add \
      dev eth0 ingress
    ```
    (run as root / sudo)

    Per-CPU qdiscs auto-created
    on multi-queue NICs ('mq').
  |
}

pfifo -> fq_codel -> fq -> htb -> clsact -> ctrl
