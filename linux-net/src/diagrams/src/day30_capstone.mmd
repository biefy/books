    Forward["NF_INET_FORWARD → ip_forward → ip_output → NF_INET_POST_ROUTING"]
    L4["tcp_v4_rcv / udp_rcv → socket lookup"]
    Sock["sk->sk_data_ready → wake reader"]
    User["app reads"]

    Pick --> Wire --> Driver --> XDP --> Build --> GRO --> Eth --> NetIf --> Ptype --> Ip --> Pre --> Route --> Decision
