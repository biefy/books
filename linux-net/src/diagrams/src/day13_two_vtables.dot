digraph two_vtables {
    rankdir=LR;
    labelloc=t;
    label="Two dispatch tables : one bind() syscall crosses both layers";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];
    nodesep=0.5; ranksep=1.4;

    call [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
          label="bind(2) syscall"];

    subgraph cluster_bsd {
        label="BSD layer : struct socket->ops (proto_ops = inet_stream_ops)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#2563eb";
        ops [shape=record, style="filled", fillcolor="#dbeafe",
             label="{.listen → inet_listen|<b>.bind → inet_bind|.poll → ...|.sendmsg → inet_sendmsg}"];
        notea [shape=note, style="filled", fillcolor="#fef3c7", fontsize=9,
               label="every callback takes\lstruct socket *\lfaces userspace\l"];
        ops -> notea [style=invis];
    }

    subgraph cluster_proto {
        label="protocol layer : struct sock->sk_prot (proto = tcp_prot)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#d97706";
        prot [shape=record, style="filled", fillcolor="#fef3c7",
              label="{<g>.get_port → inet_csk_get_port|.connect → tcp_v4_connect|.sendmsg → tcp_sendmsg|.recvmsg → tcp_recvmsg}"];
        noteb [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
               label="every callback takes\lstruct sock *\lfaces the wire\l"];
        prot -> noteb [style=invis];
    }

    call -> ops:b [color="#dc2626", style=bold, label="ops->bind"];
    ops:b -> prot:g [color="#dc2626", style=bold, label="__inet_bind calls\nsk_prot->get_port"];
}
