direction: down

title: |md
  ### struct sk_buff — the universal packet
| {near: top-center; shape: text}

skb: "struct sk_buff (the descriptor)" {
  style.fill: "#dbeafe"
  s_body: |md
    Lives in the slab cache
    `skbuff_head_cache`.

    Key fields
    (include/linux/skbuff.h:885):
    - next, prev — queue linkage
    - also rb_node, list, llist_node
    - dev — net_device
    - sk — owning socket (NULL on RX)
    - tstamp — skb_mstamp_ns (EDT)
    - cb[48] — per-proto ctrl block
    - _skb_refdst — refcnt dst_entry
    - _nfct — netfilter conntrack
    - len, data_len — total, paged
    - mac_len, hdr_len — hdr lengths
    - queue_mapping — TX queue
    - head, data, tail, end — buffer
    - mac_header, network_header,
    - transport_header
    - (above: offsets from head)
  |
}

linear: "Linear data area" {
  style.fill: "#fef3c7"
  l_body: |md
    One allocation:

    [head][reserved][data area][tail][end]

    - headroom = data - head
    - tailroom = end - tail
    - used = tail - data
  |
}

frags: "Page fragments" {
  style.fill: "#dcfce7"
  f_body: |md
    skb_shared_info, for large packets

    (e.g. GRO superpackets):

    - shinfo points to skb_shared_info (after end)

    - shinfo->frags[]: (page, offset, size) tuples

    - shinfo->frag_list: chain of skbs (TSO segments)

    - Total payload = (tail - data) + sum(frags) = len

    - data_len = sum(frags)
  |
}

skb -> linear: "head/data/tail/end"
linear -> frags: "shinfo at end"
