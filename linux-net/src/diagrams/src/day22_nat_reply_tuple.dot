digraph nat_reply_tuple {
    rankdir=TB;
    labelloc=t;
    label="NAT reuses the two-tuple machinery: rewrite the reply tuple, get reverse-mapping for free";
    fontname="Helvetica"; fontsize=13;
    node [fontname="Monaco", fontsize=10];

    orig [shape=record, style="filled", fillcolor="#dbeafe",
          label="{ ORIGINAL tuple | src = 10.0.0.5:1234 | dst = 8.8.8.8:80 }"];

    plain [shape=record, style="filled", fillcolor="#fef3c7",
           label="{ plain inverse (no NAT) | src = 8.8.8.8:80 | dst = 10.0.0.5:1234 }"];

    rewritten [shape=record, style="filled", fillcolor="#dcfce7",
               label="{ REPLY tuple (rewritten) | src = 8.8.8.8:80 | dst = 203.0.113.1:50000 | IPS_SRC_NAT set }"];

    reply [shape=box, style="filled", fillcolor="#e9d5ff",
           label="reply packet arrives\n8.8.8.8:80 -> 203.0.113.1:50000\nhash lookup hits REPLY tuple"];

    rmap [shape=box, style="filled", fillcolor="#dbeafe",
          label="auto reverse-map dst\n203.0.113.1:50000 -> 10.0.0.5:1234\n(no second rule needed)"];

    orig -> plain [style=dashed, color="#9ca3af", label="would be, without NAT"];
    orig -> rewritten [color="#16a34a", style=bold, label="NAT rewrites the\nexpected reply"];
    reply -> rewritten [color="#7c3aed", style=bold, label="same tuple lookup"];
    rewritten -> rmap [color="#2563eb", style=bold, label="reverse"];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="You write the SNAT/MASQUERADE rule once. The reply-recognition\lmechanism -- match an incoming tuple against a stored reply tuple --\lis exactly what NAT bends to its purpose. The rewrite happens at\lconfirm time; every later reply is reverse-mapped automatically.\l"];
    rmap -> note [style=invis];
}
