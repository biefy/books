digraph sockptr_funnel {
    rankdir=TB;
    labelloc=t;
    label="sockptr_t: one function body, two callers";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    // The two callers
    subgraph cluster_user {
        label="userspace syscall path";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#2563eb";
        usercall [shape=box, style="filled", fillcolor="#dbeafe",
                  label="setsockopt(fd, ...)\n__sys_setsockopt"];
        userwrap [shape=box, style="filled", fillcolor="#fef3c7",
                  label="USER_SOCKPTR(user_optval)\nis_kernel = 0\n(net/socket.c:2396)"];
        usercall -> userwrap;
    }

    subgraph cluster_bpf {
        label="BPF kernel-side path";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#7c3aed";
        bpfcall [shape=box, style="filled", fillcolor="#e9d5ff",
                 label="sock_ops BPF prog\nbpf_setsockopt(...)"];
        bpfwrap [shape=box, style="filled", fillcolor="#fef3c7",
                 label="KERNEL_SOCKPTR(ptr)\nis_kernel = 1\n(net/core/filter.c:5349)"];
        bpfcall -> bpfwrap;
    }

    // The shared function
    sk [shape=box, style="filled,rounded", fillcolor="#dcfce7",
        label="sk_setsockopt(... sockptr_t optval ...)\nnet/core/sock.c:1195"];

    userwrap -> sk [style=bold, color="#2563eb", label="converge"];
    bpfwrap  -> sk [style=bold, color="#7c3aed", label="converge"];

    // The union + is_kernel bit
    un [shape=record, style="filled", fillcolor="#dbeafe",
        label="{ sockptr_t (tagged pointer) | { <u> void *user | <k> void *kernel } | is_kernel : 1 }"];
    sk -> un [label="reads the bit"];

    // The branch
    fromuser [shape=box, style="filled,rounded", fillcolor="#fef3c7",
              label="copy_from_user()\nmust cross the user/kernel boundary"];
    fromkern [shape=box, style="filled,rounded", fillcolor="#dcfce7",
              label="memcpy()\nplain in-kernel copy"];

    un:u -> fromuser [label="is_kernel = 0", color="#2563eb"];
    un:k -> fromkern [label="is_kernel = 1", color="#7c3aed"];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="The is_kernel bit selects which arm of the union to read,\land which copy routine to use. Same body, two entry points.\l"];
    fromkern -> note [style=invis];
}
