digraph send_buffer_gauge {
    rankdir=TB;
    labelloc=t;
    label="The send buffer: sk_wmem_queued filling toward sk_sndbuf";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];

    fill_in [shape=box, style="filled,rounded", fillcolor="#dbeafe",
             label="tcp_sendmsg appends → fills"];

    // The gauge: HTML table so each band keeps a palette colour
    gauge [shape=plaintext, label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD PORT="cap" BGCOLOR="#fee2e2">sk_sndbuf (the cap) — FULL line</TD></TR>
        <TR><TD BGCOLOR="#ffffff">free space (headroom)</TD></TR>
        <TR><TD PORT="fill" BGCOLOR="#fde68a">sk_wmem_queued (bytes queued)</TD></TR>
      </TABLE>
    >];

    drain_out [shape=box, style="filled,rounded", fillcolor="#dcfce7",
               label="tcp_write_xmit drains\nas ACKs free space"];

    full [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
          label="reach the cap → block (sk_stream_wait_memory)\lor return EAGAIN (non-blocking socket)\l"];

    fill_in -> gauge:cap [style=bold, color="#2563eb"];
    gauge:fill -> drain_out [style=bold, color="#16a34a"];
    gauge:cap -> full [constraint=false, style=dashed, color="#dc2626"];
}
