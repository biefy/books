direction: down

title: |md
  ## Recent additions in 2024-2026
| {near: top-center; shape: text}

psp: "PSP (Packet Security Protocol)" {
  style.fill: "#dbeafe"
  p_body: |md
    Google's L4 encryption, in-tree 2025.
    Lighter than IPsec for datacenter use.
    Per-flow keys; HW-offload designed.
    See drivers/net/.../psp/, net/psp/.
  |
}

drop_monitor: "drop_monitor / dropwatch" {
  style.fill: "#fef3c7"
  dm_body: |md
    Tracepoint-driven 'where do packets get dropped?'
    With kfree_skb_reason, every drop has
    a category enum.
    Tools: dropwatch, perf trace skb:kfree_skb.
  |
}

devlink: "devlink" {
  style.fill: "#dcfce7"
  dl_body: |md
    Netlink-based generic device control.
    Configuration of NIC features
    (PCIe SR-IOV, DPLL, congestion control profiles).
    Replaces ad-hoc ethtool extensions.
  |
}

netlink: "NETLINK improvements" {
  style.fill: "#dbeafe"
  nl_body: |md
    YAML-based NETLINK spec generation,
    auto-generated bindings (libynl).
    See tools/net/ynl/.
    Easier to add new genetlink ops in tree.
  |
}

others: "Other 2024-2026 highlights" {
  style.fill: "#fee2e2"
  o_body: |md
    - Resilient nexthop groups
    - tcx + netkit (modern tc-bpf)
    - bigtcp (segments > 64KB)
    - Page Pool memory provider
    - net_iov for skb fragments
  |
}

psp -> netlink
drop_monitor -> netlink
devlink -> netlink
others -> netlink
