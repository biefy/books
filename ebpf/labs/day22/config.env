# SPDX-License-Identifier: GPL-2.0
#
# Day 22 lab configuration — locked references to the Linux kernel's in-tree
# BPF DCTCP struct_ops selftest.
#
# This lab does NOT ship a copy of the upstream program. It builds and drives
# the canonical object from the verified Linux v7.1 source resolved by the
# shared lab infrastructure.
#
# Provenance: released Linux tag v7.1; see ../linux-source.lock.json.
DAY22_KERNEL_TAG="v7.1"

# Selftest tree (relative to $LINUX_SRC) that owns the DCTCP struct_ops target.
DAY22_SELFTEST_DIR="tools/testing/selftests/bpf"

# The canonical upstream source this lab points at (never copied into the repo).
DAY22_DCTCP_SRC="tools/testing/selftests/bpf/progs/bpf_dctcp.c"

# Artifact produced from the canonical upstream source.
DAY22_DCTCP_OBJ="bpf_dctcp.bpf.o"

# Vtable variables inside bpf_dctcp.bpf.o and the CC names they register:
#   dctcp        -> registers algorithm name "bpf_dctcp"       (valid)
#   dctcp_nouse  -> intentionally incomplete, rejected at register time by
#                   tcp_validate_congestion_control ("does not implement
#                   required ops"); the non-fatal error is expected.
DAY22_VTABLE_OK="dctcp"
DAY22_VTABLE_REJECT="dctcp_nouse"
DAY22_CC_NAME="bpf_dctcp"

# bpffs directory this lab owns for `bpftool struct_ops register`. Because
# bpf_dctcp.c uses map-based SEC(".struct_ops") (not .struct_ops.link), register
# does not pin a link here; the directory stays empty and `unregister` is what
# actually removes the algorithm.
DAY22_PIN_DIR="/sys/fs/bpf/dctcp"
