digraph tracepoint_lanes {
    rankdir=TB;
    labelloc=t;
    label="Three lanes from the same sched_switch site to BPF";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];
    nodesep=0.5; ranksep=0.7;

    site [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
          label="sched_switch tracepoint site\n(TP_PROTO: bool preempt,\nstruct task_struct *prev, *next)"];

    fmt [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
         label="/sys/.../sched_switch/format\ldeclares lane A's schema:\lprev_comm[], prev_pid, next_comm...\l"];

    // Lane A: regular tracepoint - copied struct
    subgraph cluster_a {
        label="Lane A — tracepoint  (kernel COPIES fields)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#2563eb";
        a_ctx [shape=box, style="filled", fillcolor="#dbeafe",
               label="struct trace_event_raw_sched_switch *\nchar prev_comm[16] (readable)\nint prev_pid\nchar next_comm[16]\nNO task_struct pointer"];
        a_use [shape=box, style="filled,rounded", fillcolor="#fef3c7",
               label="ctx->prev_comm\ncopied bytes, read directly"];
        a_ctx -> a_use;
    }

    // Lane B: raw tracepoint - positional u64
    subgraph cluster_b {
        label="Lane B — raw_tracepoint  (no copy)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#d97706";
        b_ctx [shape=box, style="filled", fillcolor="#fef3c7",
               label="struct bpf_raw_tracepoint_args\nargs[0] = preempt (u64)\nargs[1] = prev (u64, cast by hand)\nargs[2] = next (u64)"];
        b_use [shape=box, style="filled,rounded", fillcolor="#fee2e2",
               label="(task_struct *)ctx->args[1]\nuntrusted: cast by position"];
        b_ctx -> b_use;
    }

    // Lane C: tp_btf - typed pointers
    subgraph cluster_c {
        label="Lane C — tp_btf  (same args[], BTF-typed)";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#16a34a";
        c_ctx [shape=box, style="filled", fillcolor="#dcfce7",
               label="same raw args[] but BTF-typed\nargs[1] = struct task_struct *\nmarked PTR_TO_BTF_ID"];
        c_use [shape=box, style="filled,rounded", fillcolor="#dbeafe",
               label="prev->comm\ndirect deref (trusted)"];
        c_ctx -> c_use;
    }

    site -> a_ctx [label="copy", color="#2563eb", style=bold, fontname="Helvetica", fontsize=9];
    site -> b_ctx [label="raw u64", color="#d97706", style=bold, fontname="Helvetica", fontsize=9];
    site -> c_ctx [label="raw + BTF", color="#16a34a", style=bold, fontname="Helvetica", fontsize=9];

    fmt -> a_ctx [label="schema", color="#7c3aed", style=dashed, fontname="Helvetica", fontsize=9];
    a_use -> b_ctx -> c_ctx [style=invis, weight=100];
}
