flowchart TD
    Start(["BPF_PROG_LOAD"])
    Walk["Walk insns\none at a time"]
    Branch{"Conditional\njump?"}
    Path1["Branch A\n(true)"]
    Path2["Branch B\n(false)"]
    Mark["Mark reg\ntypes/branch"]
    Conv{"Branches\nconverge?"}
    Merge["Merge state\n(intersect)"]
    Done["Reach exit\nevery path"]
    Pruned{"State\nexplored?"}
    OK(["Accept"])
    Limit{"Insn limit?\n(1M)"}
    Reject(["Reject:\ncomplexity"])

    Start --> Walk
    Walk --> Pruned
    Pruned -->|yes| Walk
    Pruned -->|no| Branch
    Branch -->|yes| Path1
    Branch -->|yes| Path2
    Branch -->|no| Mark
    Path1 --> Mark
    Path2 --> Mark
    Mark --> Conv
    Conv -->|yes| Merge
    Conv -->|no| Walk
    Merge --> Walk
    Walk --> Done
    Walk --> Limit
    Limit -->|yes| Reject
    Limit -->|no| Walk
    Done --> OK

    classDef hot fill:#fef3c7,stroke:#d97706
    classDef ok fill:#dcfce7,stroke:#16a34a
    classDef bad fill:#fee2e2,stroke:#dc2626
    class Branch,Conv,Limit,Pruned hot
    class OK ok
    class Reject bad
