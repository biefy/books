direction: down

title: |md
  ## CO-RE relocation: kernel A vs kernel B
| {near: top-center; shape: text}

# Kernel A side
ka: "Kernel A (build host)" {
  style.fill: "#fef3c7"
  layout_a: |md
    `task_struct` layout (A):
    ```
    off  field
    0    state
    24   stack
    32   flags
    ...
    1872 real_parent ←here
    1880 parent
    ...
    2384 tgid
    2388 pid
    ```
  |
}

# Kernel B side (drifted layout)
kb: "Kernel B (target, other ver)" {
  style.fill: "#dbeafe"
  layout_b: |md
    `task_struct` layout (B):
    ```
    off  field
    0    state
    24   stack
    32   flags
    ...
    1920 real_parent ←+48
    1928 parent
    ...
    2440 tgid ←+56
    2444 pid
    ```
  |
}

# the .bpf.o (single artifact)
obj: "hello.bpf.o (built once on A)" {
  shape: package
  style.fill: "#dcfce7"
  src: |md
    Source:
    ```c
    BPF_CORE_READ(task,
      real_parent, tgid);
    ```
  |
  emitted: |md
    Emitted (reads real_parent, tgid):
    ```
    r1 = task
    r1 = *(u64*)(r1+OFF)
    r1 = *(u32*)(r1+OFF)
    ```
    + CO-RE relocation records:
    ```
    relo kind=field_byte_offset
      type=task_struct
      field=real_parent
    relo kind=field_byte_offset
      type=task_struct
      field=tgid
    ```
  |
  src -> emitted: {style.opacity: 0}
}

ka -> kb: "layout drifts\nacross versions" {style.stroke-dash: 3}
kb -> obj: "compile against\nA's vmlinux.h"

# At load time
load_a: "Load on kernel A:\nlibbpf patches +1872, +2384\n(offsets from A's BTF)" {style.fill: "#dcfce7"}
load_b: "Load on kernel B:\nlibbpf patches +1920, +2440\n(offsets from B's BTF)" {style.fill: "#dcfce7"}

obj -> load_a
load_a -> load_b

ka.layout_a -> load_a
kb.layout_b -> load_b

note: "Same .bpf.o, two different patched offsets at load time.\n\nWithout CO-RE, you'd recompile for every kernel.\nWith CO-RE, you ship one .o and it adapts." {near: bottom-center; shape: text}
