flowchart TD
    Cur["bpf_get_current_task_btf()<br/>returns trusted *task_struct"]
    Acq["bpf_task_acquire(cur)<br/>refcount: 1<br/>verifier: ref id 1"]
    Slot["map slot kptr_xchg<br/>atomic swap"]
    Map["{ key=k, value=&val{t→TASK} }"]

    Later["...later, in another invocation..."]
    Lookup["bpf_map_lookup_elem(&m, &k)"]
    Take["bpf_kptr_xchg(&v->t, NULL)<br/>returns the task<br/>verifier: ref id 2"]
    Use["use task fields"]
    Rel["bpf_task_release(t)<br/>refcount: 0<br/>verifier: ref id 2 closed"]

    Cur --> Acq --> Slot --> Map
    Map --> Later --> Lookup --> Take --> Use --> Rel

