digraph ctx_vs_ptregs {
    rankdir=LR;
    labelloc=t;
    label="Two shapes of ctx: trampoline u64[] vs. struct pt_regs snapshot";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];
    nodesep=0.5; ranksep=1.0;

    // Left: fentry trampoline ctx[] array
    subgraph cluster_fentry {
        label="Shape A — fentry / fexit / tp_btf";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#2563eb";
        fctx [shape=record, style="filled", fillcolor="#dbeafe",
              label="{ u64 ctx[] (trampoline) | { ctx[0] = f  (struct file *) | ctx[1] = buf (char *) | ctx[2] = n  (size_t) } }"];
        fnote [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
               label="ctx[0] IS the typed first arg.\lBPF_PROG indexes straight in:\l___bpf_ctx_cast -> ctx[0], ctx[1]...\l"];
        fctx -> fnote [style=invis];
    }

    // Right: pt_regs frame as stack of named slots
    subgraph cluster_ptregs {
        label="Shape B — kprobe / kretprobe";
        fontname="Helvetica"; fontsize=11; style="rounded"; color="#d97706";
        pregs [shape=record, style="filled", fillcolor="#fef3c7",
               label="{ struct pt_regs * (saved regs) | { 0x00  r15  (callee-saved) | 0x08  r14 | ... | 0x60  dx  = arg3 | 0x68  si  = arg2 | 0x70  di  = arg1 = f } }"];
    }

    arg0 [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
          label="arg0 = f\n(struct file *)"];

    // PT_REGS_PARM1 path: di -> arg0
    pregs -> arg0 [label="PT_REGS_PARM1\n= di @ 0x70", color="#7c3aed", style=bold,
                   fontname="Helvetica", fontsize=9];

    // Break 2 red arrow from r15 @ 0x00
    garbage [shape=box, style="filled,rounded", fillcolor="#fee2e2",
             label="BREAK 2:\nBPF_PROG reads ctx[0]\n= r15 @ 0x00 = GARBAGE"];
    pregs -> garbage [label="wrong macro", color="#dc2626", style=bold,
                      fontname="Helvetica", fontsize=9];

    fctx -> pregs [label="same data,\ntwo containers", color="#dc2626", style=dashed,
                   fontname="Helvetica", fontsize=9];
}
