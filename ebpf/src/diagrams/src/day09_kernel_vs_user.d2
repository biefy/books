direction: down

title: "Kernel stack vs user stack walking" {shape: text; style.font-size: 28; near: top-center}

kstack: "Kernel stack\n`bpf_get_stackid(ctx, m, 0)`" {
  style.fill: "#dbeafe"
  ks_what: "Walks kernel ip frames using:\n- ORC unwinder (default on x86_64 since 4.14)\n- or frame pointers (CONFIG_FRAME_POINTER)\n\n✅ Always available in kernel context\n✅ Symbolized via /proc/kallsyms\n✅ Cheap (~1µs)\n\nFrame format: array of kernel virtual addresses" {
    style.fill: "#eff6ff"
  }
}

ustack: "User stack\n`bpf_get_stackid(`\n`  ctx, m, BPF_F_USER_STACK)`" {
  style.fill: "#fef3c7"
  us_what: "Walks userspace stack of current task:\n- Requires CONFIG_FRAME_POINTER in\n  user binary, OR DWARF unwind info\n  (slower, kernel can't use)\n\n⚠️ Userspace stacks often lack\n    frame pointers (gcc -fomit-\n    frame-pointer default on amd64)\n⚠️ JIT'd languages (JS, Java)\n    need extra symbol info\n\n✅ Symbolize via /proc/PID/maps\n    + ELF symbols\n✅ Reveals \"which function in your\n    app called read()\"\n\nFrame format: array of\nuser virtual addresses" {
    style.fill: "#fffbeb"
  }
}

both: "Both at once\n`bpf_get_stack(ctx, buf, sz, 0)`\n+ `bpf_get_stack(ctx, buf, sz, USER)`" {
  style.fill: "#dcfce7"
  both_what: "Use two separate calls to capture a mixed\nkernel+user stack (kernel frames stack on top\nof the syscall entry, user frames below).\n\nCombine in userspace before symbolizing." {
    style.fill: "#f0fdf4"
  }
}

flag: "Flags:\n- 0 (kernel)\n- BPF_F_USER_STACK\n- BPF_F_FAST_STACK_CMP\n- BPF_F_REUSE_STACKID" {
  style.fill: "#f3f4f6"
}

kstack -> ustack -> both -> flag {style.stroke-dash: 4}
