direction: down

title: |md
  ## BTF kinds: how the kernel describes its own types
| {near: top-center; shape: text}

basic: "Basic kinds" {
  style.fill: "#dbeafe"
  b_body: |md
    - INT — int, char, long
    - PTR — pointer to type
    - ARRAY — fixed-size array
    - STRUCT — named fields
    - UNION — union variant
    - ENUM — enum with values
    - FWD — forward decl
    - TYPEDEF — typedef alias
    - VOLATILE / CONST / RESTRICT
  |
}

func: "Function & decl kinds" {
  style.fill: "#fef3c7"
  f_body: |md
    - FUNC_PROTO — function signature
    - FUNC — actual function
    - VAR — global variable
    - DATASEC — data section
    - DATASEC — data section
  |
}

new: "Newer additions" {
  style.fill: "#dcfce7"
  n_body: |md
    - FLOAT — added 2021
    - DECL_TAG — annotations
    - TYPE_TAG — type-level tags
    - ENUM64 — 64-bit enums
    - ENUM64 — 64-bit enums
  |
}

count: "~17 kinds total. Inspect via: bpftool btf dump" {shape: text}

basic -> func
func -> new
new -> count
