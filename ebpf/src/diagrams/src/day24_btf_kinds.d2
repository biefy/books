direction: down

title: |md
  ## BTF kinds: how the kernel describes its own types
| {near: top-center; shape: text}

basic: "Basic kinds" {
  style.fill: "#dbeafe"
  b_body: |md
    BTF_KIND_INT       — int, char, long
    BTF_KIND_PTR       — pointer to type
    BTF_KIND_ARRAY     — fixed-size array
    BTF_KIND_STRUCT    — struct with named fields
    BTF_KIND_UNION     — union variant
    BTF_KIND_ENUM      — enum with values
    BTF_KIND_FWD       — forward decl
    BTF_KIND_TYPEDEF   — typedef alias
    BTF_KIND_VOLATILE/CONST/RESTRICT
  |
}

func: "Function and func decl kinds" {
  style.fill: "#fef3c7"
  f_body: |md
    BTF_KIND_FUNC_PROTO — function signature
    BTF_KIND_FUNC       — actual function
    BTF_KIND_VAR        — global variable
    BTF_KIND_DATASEC    — data section
  |
}

new: "Newer additions" {
  style.fill: "#dcfce7"
  n_body: |md
    BTF_KIND_FLOAT      — added 2021
    BTF_KIND_DECL_TAG   — annotations
    BTF_KIND_TYPE_TAG   — type-level tags
    BTF_KIND_ENUM64     — 64-bit enums
  |
}

count: "About 17 kinds total. Inspect via bpftool btf dump." {shape: text}

