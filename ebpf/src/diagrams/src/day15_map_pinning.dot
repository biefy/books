digraph map_pinning {
    rankdir=LR;
    labelloc=t;
    label="Three references keep one LPM trie alive: two process fds plus a bpffs pin";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];
    nodesep=0.6; ranksep=1.3;

    // The shared kernel object
    mapobj [shape=box, style="filled,rounded", fillcolor="#dbeafe", fontname="Helvetica", fontsize=11,
            label="deny: LPM trie\n(one kernel object)\n\nrefcount = 3"];

    // Process A: loader
    loader [shape=box, style="filled,rounded", fillcolor="#fef3c7",
            label="xdp_block loader\nholds fd + bpf_link\n(attaches XDP)"];

    // Process B: CLI
    cli [shape=box, style="filled,rounded", fillcolor="#fef3c7",
         label="blockcli\nbpf_obj_get(\"/sys/fs/bpf/deny\")\nholds its own fd"];

    // The pin
    pin [shape=box, style="filled,rounded", fillcolor="#dcfce7",
         label="/sys/fs/bpf/deny\n(bpffs pin)\nholds its own reference"];

    loader -> mapobj [label="fd ref", color="#d97706", style=bold, fontname="Helvetica", fontsize=9];
    cli -> mapobj [label="fd ref", color="#d97706", style=bold, fontname="Helvetica", fontsize=9];
    pin -> mapobj [label="pin ref", color="#16a34a", style=bold, fontname="Helvetica", fontsize=9];

    note [shape=note, style="filled", fillcolor="#e9d5ff", fontsize=9, fontname="Helvetica",
          label="kill xdp_block:\l  - its fd drops\l  - the bpf_link drops (XDP auto-detaches)\l\lBUT the pin still holds a reference,\lso the map stays alive until you\l`rm /sys/fs/bpf/deny`.\l"];
    mapobj -> note [style=invis];
}
