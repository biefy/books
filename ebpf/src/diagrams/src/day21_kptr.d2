direction: down

title: |md
  ## kptr: storing a kernel pointer across runs
| {near: top-center; shape: text}

problem: "Problem: tp_btf gives a *task_struct" {
  style.fill: "#fee2e2"
  p_body: |md
    Pointer is
    **trusted** only
    for this run.

    After return,
    task may be
    freed.

    Saving it in a
    map is rejected
    by the verifier:

    "cannot reference
    object of type X
    in this map".
  |
}

solution: "Solution: refcounted kptr in map" {
  style.fill: "#dcfce7"
  s_code: |md
    ```c
    struct val {
      struct task_struct
        __kptr *t;
    };
    struct {
      __uint(type,
        BPF_MAP_TYPE_HASH);
      __type(value,
        struct val);
    } m SEC(".maps");
    ```
  |
  s_notes: |md
    `__kptr`
    marks the slot

    as a
    refcounted
    pointer.

    `bpf_kptr_xchg`
    (slot, new)

    swaps it
    atomically;
    old must be
    released.
  |
  s_code -> s_notes: { style.opacity: 0 }
}

flow: "Lifecycle" {
  style.fill: "#fef3c7"
  f_body: |md
    1. acquire kfunc:

    refcount=1,
    ref id N

    2. xchg into map:

    ref id N closed,
    slot owns refcount

    3. lookup:

    kptr_xchg(slot,
    NULL) returns
    kptr, ref id M
    opens

    4. release:

    bpf_task_release,
    ref id M closed

    All transitions
    verifier-checked.

    No leaks,
    no UAFs.
  |
}

problem -> solution -> flow
