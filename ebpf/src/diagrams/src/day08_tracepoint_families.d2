direction: down

title: "Common tracepoint families" {near: top-center; shape: text; style.font-size: 24; style.bold: true}

sched: "sched/*" {
  style.fill: "#dbeafe"
  sched_list: "- sched_switch\n- sched_wakeup, wakeup_new\n- sched_process_exec\n- sched_process_exit\n- sched_process_fork\n- sched_migrate_task" {shape: text}
}

block: "block/*" {
  style.fill: "#dcfce7"
  block_list: "- block_rq_issue\n- block_rq_complete\n- block_bio_queue\n- block_bio_complete" {shape: text}
}

net: "net/* skb/*" {
  style.fill: "#fef3c7"
  net_list: "- net_dev_xmit\n- netif_rx, napi_*\n- skb_copy_datagram_iovec" {shape: text}
}

syscalls: "syscalls/*" {
  style.fill: "#fee2e2"
  syscalls_list: "- sys_enter_xxx\n- sys_exit_xxx\n- one tp per syscall (autogenerated)\n\n⚠️ Slower than fentry on raw_syscalls\nPrefer fentry/__x64_sys_xxx" {shape: text}
}

mm: "kmem/* writeback/*" {
  style.fill: "#e0e7ff"
  mm_list: "- kmem_cache_alloc\n- kmalloc, kfree\n- mm_page_alloc\n- writeback_dirty_page" {shape: text}
}

fs: "filemap/* ext4/*" {
  style.fill: "#fce7f3"
  fs_list: "- filemap_fault\n- ext4_da_write_begin\n- file_check_and_advance_wb_err" {shape: text}
}

sched -> block -> net -> syscalls -> mm -> fs: {style.opacity: 0}

note: "Discover what's available on your kernel:\n\n  ls /sys/kernel/tracing/events/\n  cat /sys/kernel/tracing/events/sched/sched_switch/format\n\nEach file has a format showing the raw struct layout.\nFor tp_btf, use the same name: tp_btf/sched_switch." {near: bottom-center; shape: text}
