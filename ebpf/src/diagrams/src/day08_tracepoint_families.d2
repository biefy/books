direction: right

title: |md
  ## Common tracepoint families
| {near: top-center; shape: text}

sched: "sched/*" {
  style.fill: "#dbeafe"
  sched_list: |md
    - sched_switch
    - sched_wakeup, wakeup_new
    - sched_process_exec
    - sched_process_exit
    - sched_process_fork
    - sched_migrate_task
  |
}

block: "block/*" {
  style.fill: "#dcfce7"
  block_list: |md
    - block_rq_issue
    - block_rq_complete
    - block_bio_queue
    - block_bio_complete
  |
}

net: "net/* skb/*" {
  style.fill: "#fef3c7"
  net_list: |md
    - net_dev_xmit
    - netif_rx, napi_*
    - skb_copy_datagram_iovec
  |
}

syscalls: "syscalls/*" {
  style.fill: "#fee2e2"
  syscalls_list: |md
    - sys_enter_xxx
    - sys_exit_xxx
    (one tp per syscall — autogenerated)

    ⚠️ Slower than fentry on raw_syscalls
    Prefer fentry/__x64_sys_xxx
  |
}

mm: "kmem/* writeback/*" {
  style.fill: "#e0e7ff"
  mm_list: |md
    - kmem_cache_alloc
    - kmalloc, kfree
    - mm_page_alloc
    - writeback_dirty_page
  |
}

fs: "filemap/* ext4/*" {
  style.fill: "#fce7f3"
  fs_list: |md
    - filemap_fault
    - ext4_da_write_begin
    - file_check_and_advance_wb_err
  |
}

note: |md
  **Discover what's available on your kernel:**
  ```
  ls /sys/kernel/tracing/events/
  cat /sys/kernel/tracing/events/sched/sched_switch/format
  ```
  Each file has a `format` showing the raw struct layout.
  For tp_btf, use the same name: `tp_btf/sched_switch`.
| {near: bottom-center; shape: text}
