digraph btf_record {
    rankdir=LR;
    labelloc=t;
    label="btf_record: parsed ONCE at map create, walked on EVERY free";
    fontname="Helvetica"; fontsize=14;
    node [fontname="Monaco", fontsize=10];
    nodesep=0.45; ranksep=0.8;

    // value struct memory layout
    value [shape=record, style="filled", fillcolor="#fef3c7", fontsize=10,
           label="{ struct val (in map) | <f0> off 0: saved_at_ns\n(8 bytes, plain) | <f8> off 8: __kptr task\n(8-byte refcounted slot) }"];

    // btf_record table
    record [shape=record, style="filled", fillcolor="#dbeafe", fontsize=10,
            label="{ btf_record (one per value TYPE) | <r0> offset = 8\ntype = BPF_KPTR_REF\ndtor = bpf_task_release_dtor }"];

    // the free walker
    walker [shape=box, style="filled,rounded", fillcolor="#e9d5ff", fontsize=10,
            label="bpf_obj_free_fields(rec, value)\non delete / evict / map-destroy:\nxchg slot -> NULL, then call dtor"];

    value:f8 -> record:r0 [label="this byte is special", color="#2563eb", style=bold, fontname="Helvetica", fontsize=9];
    walker -> record:r0 [label="reads the row", color="#7c3aed", style=bold, fontname="Helvetica", fontsize=9];
    record:r0 -> value:f8 [label="dtor fires on the slot's ptr", color="#dc2626", style=bold, fontname="Helvetica", fontsize=9];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="btf_parse_fields() builds the record at map-create time.\lThe plain saved_at_ns byte has NO row, so it is left untouched.\lOnly fields that appear in the record are honored.\l"];
    walker -> note [style=invis];
}
