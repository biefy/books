flowchart LR
    subgraph Old["Classic tc-bpf attach (legacy)"]
        T1["sudo tc qdisc add dev eth0 clsact"]
        T2["sudo tc filter add dev eth0 ingress<br/>bpf da obj prog.o sec tc"]
        T3["BPF program now runs<br/>but no link FD owns it"]
        T4["To detach:<br/>tc filter del ..."]
        T5["Multi-program:<br/>manage tc filter priorities by hand"]

        T1 --> T2 --> T3 --> T4
        T3 --> T5
    end

    subgraph New["tcx attach (modern, 6.6+)"]
        X1["bpf_program__attach_tcx(prog, ifindex, &opts)"]
        X2["Returns bpf_link FD"]
        X3["BPF program runs"]
        X4["Closing the FD detaches"]
        X5["Multi-program:<br/>BPF_F_BEFORE / BPF_F_AFTER<br/>declarative ordering"]

        X1 --> X2 --> X3 --> X4
        X3 --> X5
    end

    classDef bad fill:#fee2e2,stroke:#dc2626
    classDef ok fill:#dcfce7,stroke:#16a34a
    class T1,T2,T3,T4,T5 bad
    class X1,X2,X3,X4,X5 ok
