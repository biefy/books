direction: down

title: |md
  ## Where XDP runs in the network stack
| {near: top-center; shape: text}

driver: "NIC driver RX path" {
  style.fill: "#dbeafe"
  d_body: |md
    1. Hardware DMAs packet to RX ring
    2. NAPI poll wakes driver
    3. Driver receives raw frame
    4. **XDP runs here** (before skb alloc!)
    5. Decision: PASS / DROP / TX / REDIRECT
  |
}

xdp_layer: "XDP program (BPF)" {
  style.fill: "#fef3c7"
  x_body: |md
    Sees: raw ethernet frame
    Returns: action constant

    Cost: ~50 ns + your logic
    Throughput: 10-100 Mpps per core
  |
}

skb_alloc: "If XDP_PASS:\nallocate sk_buff (~500 ns)" {style.fill: "#fee2e2"}

stack: "Linux network stack" {
  style.fill: "#dcfce7"
  s_body: |md
    - tc ingress (next BPF hook)
    - netfilter (iptables/nftables)
    - IP routing
    - Socket lookup
    - Application
  |
}

driver -> xdp_layer
xdp_layer -> skb_alloc: "PASS"
xdp_layer -> driver: "DROP, TX, REDIRECT" {style.stroke-dash: 4}
skb_alloc -> stack

note: |md
  **Why XDP is fast:** runs before skb allocation, before any kernel net stack work.
  Just a function call from the driver with a pointer to the packet.
| {near: bottom-center; shape: text}
