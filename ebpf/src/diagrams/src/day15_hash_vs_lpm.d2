direction: down

title: |md
  ## Hash vs LPM: pick by lookup pattern
| {near: top-center; shape: text}

hash: "BPF_MAP_TYPE_HASH\n\nUse when keys are exact match:\n- {tcp_flow_5tuple} → state\n- {pid} → counter\n- {socket_cookie} → metadata\n\nLookup: O(1) hash + bucket walk\nMemory: O(N) entries\n\nCannot match prefixes." {
  style.fill: "#dbeafe"
}

lpm: "BPF_MAP_TYPE_LPM_TRIE\n\nUse when keys are prefixes:\n- {prefixlen=24, 192.168.1.0} → action\n- {prefixlen=64, IPv6 net} → action\n\nLookup: O(prefix_len) bit walk\nMemory: O(N + total_bits) for tree nodes\n\nReturns longest matching prefix.\nPer IPv4: max 32 hops; usually < 5\nPer IPv6: max 128 hops; usually < 16" {
  style.fill: "#dcfce7"
}

key_struct: "Key struct for LPM:" {
  style.fill: "#fef3c7"
  ks_body: |md
    ```c
    struct ipv4_key {
        __u32 prefixlen; // ALWAYS first
        __u32 addr;      // big-endian
    };
    ```
  |
  ks_note: "prefixlen first: kernel reads it.\naddr = big-endian network address." {
    style.fill: "#fef9e7"
  }
  ks_body -> ks_note
}

hash -> lpm: "exact-match keys" {style.stroke-dash: 4}
lpm -> key_struct: "prefix + value keys" {style.stroke-dash: 4}
