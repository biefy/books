direction: down

title: |md
  ## One tracepoint event, three BPF interfaces
| {near: top-center; shape: text}

kernel: "Kernel TRACE_EVENT" {
  style.fill: "#fef3c7"
  body: |md
    `trace_sched_switch(preempt, prev, next)`

    - **Does:** marks scheduler switch point.
    - **Why next:** consumers pick how much structure.
    - **State:** original C args still in hand.
  |
}

regular: "SEC(\"tracepoint/sched/sched_switch\")" {
  style.fill: "#fee2e2"
  body: |md
    - **Does:** kernel copies selected fields  
      into `trace_event_raw_sched_switch`.
    - **State:** stable copied bytes:  
      `prev_comm`, `prev_pid`, `next_comm`, ...
    - **Tradeoff:** stable format, but  
      no live `task_struct *` access.
  |
}

raw: "SEC(\"raw_tracepoint/sched_switch\")" {
  style.fill: "#fde68a"
  body: |md
    - **Does:** exposes raw tracepoint args  
      in `bpf_raw_tracepoint_args`.
    - **State:** `ctx->args[0]`, `ctx->args[1]`, ...  
      decoded by position.
    - **Tradeoff:** no copied event struct,  
      but less type help than `tp_btf`.
  |
}

btf: "SEC(\"tp_btf/sched_switch\")" {
  style.fill: "#dcfce7"
  body: |md
    - **Does:** passes BTF-typed args:  
      `bool preempt`, `task_struct *prev`, `*next`.
    - **State:** live typed pointers valid  
      during the callback.
    - **Tradeoff:** needs kernel BTF and  
      CO-RE care for struct fields.
  |
}

kernel -> regular: "copy fields"
regular -> raw: "raw slots"
raw -> btf: "BTF-typed args"
