direction: down

title: |md
  ## Same hook, two interfaces: raw tracepoint vs tp_btf
| {near: top-center; shape: text}

kernel: "Kernel scheduler" {
  style.fill: "#fef3c7"
  call: "schedule()" {shape: rectangle}
  trace: "trace_sched_switch(preempt, prev, next)" {shape: rectangle; style.fill: "#fee2e2"}
  call -> trace: "calls TRACE_EVENT macro"
}

raw: "BPF: SEC(\"tracepoint/sched/sched_switch\")" {
  style.fill: "#fee2e2"
  raw_what: |md
    Kernel **copies** fields into
    `struct trace_event_raw_sched_switch`:
    ```c
    char prev_comm[16];
    pid_t prev_pid;
    int prev_prio;
    long prev_state;
    char next_comm[16];
    pid_t next_pid;
    int next_prio;
    ```
    You read **copied bytes** from `ctx`.

    ❌ Cannot reach `prev->parent`
    ❌ Cannot reach `prev->mm->start_brk`
    ✅ Stable across kernel versions
    ✅ Layout in /sys/kernel/tracing/...
  |
}

btf: "BPF: SEC(\"tp_btf/sched_switch\")" {
  style.fill: "#dcfce7"
  btf_what: |md
    Kernel hands you **live typed pointers**:
    ```c
    BPF_PROG(p,
      bool preempt,
      struct task_struct *prev,  ← LIVE
      struct task_struct *next)  ← LIVE
    ```
    Direct deref of any field works:
    ```c
    bpf_printk("%s -> %s",
               prev->comm, next->comm);
    bpf_printk("ppid=%d",
               prev->real_parent->tgid);
    ```

    ✅ Reach any field anywhere
    ✅ ~50% lower overhead (no copy)
    ✅ Same attach point — same stability
    ❌ Requires BTF in kernel (basically always)
  |
}

kernel.trace -> raw: "via raw tracepoint\n(legacy)" {style.stroke: "#dc2626"}
kernel.trace -> btf: "via tp_btf\n(modern)" {style.stroke: "#16a34a"}
