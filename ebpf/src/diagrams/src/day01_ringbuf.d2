direction: down

title: |md
  ## ringbuf: many writers, one reader, no locks
| {near: top-center; shape: text}

producers: "BPF prog instances (per-CPU)" {
  grid-columns: 2
  style.fill: "#dbeafe"
  cpu0: "CPU 0"
  cpu1: "CPU 1"
  cpu2: "CPU 2"
  cpu3: "CPU 3"
}

ring: "ringbuf shared memory (256 KiB)" {
  shape: rectangle
  style.fill: "#fef3c7"
  rec0: "[hdr | event 0]"
  rec1: "[hdr | event 1]"
  rec2: "[hdr | event 2]"
  rec3: "[hdr | event 3]"
  free: "...free space..." {style.fill: "#f9fafb"}
  rec0 -- rec1 -- rec2 -- rec3 -- free
}

producers -> ring: "reserve+submit\n(atomic cmpxchg\non producer pos)"

reader: "Userspace consumer\n(epoll on ring fd)" {shape: rectangle; style.fill: "#dcfce7"}
ring -> reader: "ring_buffer__poll()"

note: "Producer: bpf_ringbuf_reserve()\nadvances producer pos with cmpxchg\n\nConsumer: reads in producer order,\nregardless of submit order\n\nPer-record header: holds size + busy bit\n(lets submit/discard race-free)" {near: bottom-center; shape: text}
