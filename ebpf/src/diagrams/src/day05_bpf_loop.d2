direction: down

title: |md
  ### Inline loop vs bpf_loop
  #### what the verifier sees
| {near: top-center; shape: text}

inline: "Inline loop" {
  style.fill: "#fee2e2"
  desc: |md
    `for (i=0; i<100; i++) { body; }`

    Verifier perspective:
    - **Unroll all 100 iterations**
    - one giant straight-line program
    - each branch in `body` forks × 100
    - total paths = 100 × paths(body)
    - complexity grows fast; hits 1M budget
    - works for small, simple bodies (~100 iter)
    - breaks for complex bodies
    - breaks for n > a few hundred
  |
}

bpf_loop_call: "bpf_loop(100, callback, ctx, 0)" {
  style.fill: "#dcfce7"
  desc: |md
    Verifier perspective:
    - **Verify `callback` body once**
    - one path, one iteration
    - `bpf_loop` is a black-box helper
    - runs verified callback ≤ 100×
    - complexity = paths(callback)
    - independent of iter count
    - works for huge counts (1M? no problem)
    - trade: can't share stack vars directly
    - must pass `ctx`
  |
}

inline -> bpf_loop_call: "preferred when:\n- iter count > ~100\n- body has branches\n- body is non-trivial" {style.stroke-dash: 4}
