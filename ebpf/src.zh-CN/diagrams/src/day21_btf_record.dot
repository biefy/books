digraph btf_record {
    rankdir=TB;
    labelloc=t;
    label="btf_record：创建映射时只解析一次，每次释放都会遍历";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    nodesep=0.45; ranksep=0.8;

    // value struct memory layout
    value [shape=record, style="filled", fillcolor="#fef3c7", fontsize=10,
           label="{ struct val（位于映射中） | <f0> 偏移 0：saved_at_ns\n（8 字节，普通字段） | <f8> 偏移 8：__kptr task\n（8 字节引用计数槽位） }"];

    // btf_record table
    record [shape=record, style="filled", fillcolor="#dbeafe", fontsize=10,
            label="{ btf_record（每种值类型一个） | <r0> offset = 8\ntype = BPF_KPTR_REF\ndtor = bpf_task_release_dtor }"];

    // the free walker
    walker [shape=box, style="filled,rounded", fillcolor="#e9d5ff", fontsize=10,
            label="bpf_obj_free_fields(rec, value)\n删除 / 驱逐 / 销毁映射时：\nxchg 将槽位置为 NULL，再调用 dtor"];

    value:f8 -> record:r0 [label="这个字节具有特殊含义", color="#2563eb", style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    walker -> record:r0 [label="读取这一行", color="#7c3aed", style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    record:r0 -> value:f8 [label="对槽位中的指针调用 dtor", color="#dc2626", style=bold, fontname="Noto Sans CJK SC", fontsize=9];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="btf_parse_fields() 在创建映射时构建该记录。\lsaved_at_ns 这个普通字段没有对应行，因此不会被改动。\l只有记录中出现的字段才会得到处理。\l"];
    walker -> note [style=invis];
}
