digraph queue_map {
    rankdir=TB;
    labelloc=t;
    label="键控映射与 BPF QUEUE 映射（无键 FIFO）的对比";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC"];
    nodesep=0.4; ranksep=0.5;

    subgraph cluster_keyed {
        label="键控映射（哈希 / 数组）——你已经见过这些映射";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        keyed [shape=record, style="filled", fillcolor="#dbeafe", fontsize=10,
               label="{ 键 | 值 } | { 0 | 4123 } | { 1 | 5567 } | { 2 | 880 }"];
        keynote [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
                 label="按键查找。\l随机访问。\l"];
        keyed -> keynote [style=invis];
    }

    subgraph cluster_queue {
        label="BPF_MAP_TYPE_QUEUE central_q——无键";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#d97706";
        tube [shape=record, style="filled", fillcolor="#fef3c7", fontsize=11,
              label="{ <f> 4123（队首） | 5567 | <b> 880（队尾） }"];
        push [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
              label="bpf_map_push_elem(&central_q, &pid)\n追加到队尾"];
        pop [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
             label="dispatch_to_cpu:\nbpf_map_pop_elem -> 4123\n从队首移除最旧元素"];
        push -> tube:b [label="push", color="#d97706", style=bold, fontsize=9];
        tube:f -> pop [label="pop", color="#dc2626", style=bold, fontsize=9];
    }

    keyed -> tube [style=invis];
}
