digraph trampoline_abi {
    rankdir=TB;
    labelloc=t;
    label="跳板衔接两种不兼容的调用约定";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    nodesep=0.5; ranksep=0.9;

    // 左侧：SysV 原生 ABI 一侧
    subgraph cluster_native {
        label="System V ABI（filename_unlinkat 的调用方式）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        regs [shape=record, style="filled", fillcolor="#dbeafe",
              label="原生参数寄存器|rdi = dfd|rsi = name|rdx, rcx, ...（此处未使用）"];
    }

    // 中间：跳板将寄存器保存到 ctx[]
    subgraph cluster_tramp {
        label="生成的跳板";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#7c3aed";
        spill [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
               label="将原生寄存器保存到栈上的\nu64 ctx[] 中"];
        ctx [shape=record, style="filled", fillcolor="#fef3c7",
             label="u64 ctx[]|ctx[0] = rdi  (dfd)|ctx[1] = rsi  (name)"];
        spill -> ctx;
    }

    // 右侧：BPF 一侧
    subgraph cluster_bpf {
        label="BPF 调用约定";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#d97706";
        r1 [shape=box, style="filled,rounded", fillcolor="#dbeafe",
            label="R1  ->  ctx\n（每个 BPF 程序接收的\n唯一指针）"];
        prog [shape=record, style="filled", fillcolor="#dcfce7",
              label="BPF_PROG(on_unlink, ...)|将 ctx[0] 转换为 int dfd|将 ctx[1] 转换为 struct filename *name"];
        r1 -> prog;
    }

    regs -> spill [label="ABI 不匹配", color="#dc2626", style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    ctx -> r1 [label="R1 指向该数组", color="#7c3aed", style=bold, fontname="Noto Sans CJK SC", fontsize=9];

    btf [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
         label="BTF 向 fentry 提供参数类型，\l因此跳板知道要保存多少个槽位，\lBPF_PROG 也知道如何转换每个槽位。\l"];
    prog -> btf [style=invis];
}
