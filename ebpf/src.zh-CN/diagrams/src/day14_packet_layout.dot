digraph packet_layout {
    rankdir=TB;
    labelloc=t;
    label="数据包是平坦的字节缓冲区：ethhdr | iphdr | L4，以及遍历它的指针跳转";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    // 字节标尺：一条记录中的各单元格表示字节范围
    ruler [shape=record, style="filled", fillcolor="#fef3c7",
        label="{<eth> 以太网\n字节 0..13\n（14 字节）|<ip> IPv4 头部\n字节 14..33\n（最少 20 字节）|<l4> L4（TCP/UDP/ICMP）\n字节 34..}"];

    // 字段注释
    hproto [shape=box, style="filled", fillcolor="#dbeafe",
        label="h_proto（EtherType）\n__be16 @ 偏移 12..13\n0x0800 = IPv4"];
    proto [shape=box, style="filled", fillcolor="#dbeafe",
        label="ip->protocol\n__u8 @ 帧偏移 23\n（= 14 + 9）\nICMP=1 TCP=6 UDP=17"];

    hproto -> ruler:eth [color="#2563eb", style=bold];
    proto  -> ruler:ip  [color="#2563eb", style=bold];

    // 标尺上方的指针跳转
    data0 [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
        label="eth = data\n（字节 0）"];
    hop1 [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
        label="(void *)(eth + 1)\n前进 sizeof(ethhdr)=14\n-> IP 头部起点"];
    hop2 [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
        label="(void *)(ip + 1)\n前进 sizeof(iphdr)=20\n-> L4 起点"];

    data0 -> hop1 [label="跳过以太网头部（+14）", color="#7c3aed", style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    hop1  -> hop2 [label="跳过 IP 头部（+20）", color="#7c3aed", style=bold, fontname="Noto Sans CJK SC", fontsize=9];

    data0 -> ruler:eth [style=invis];
    hop1  -> ruler:ip  [style=invis];
    hop2  -> ruler:l4  [style=invis];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
        label="结构体指针运算与布局对应：\leth+1 = “跳过一个以太网头部”\lip+1  = “跳过一个 IP 头部”\l"];
    note -> ruler:l4 [style=invis];
}
