digraph egress_retval_map {
    rankdir=LR;
    labelloc="t";
    fontname="Noto Sans CJK SC";
    fontsize=16;
    label="cgroup_skb/egress：BPF 返回值 -> 位拆分 -> NET_XMIT 结果";
    node [fontname="Noto Sans Mono CJK SC", fontsize=11];
    edge [fontname="Noto Sans CJK SC", fontsize=10];

    subgraph cluster_ret {
        label="你的程序返回（0-3）";
        fontname="Noto Sans CJK SC";
        style=filled;
        color="#dbeafe";
        r0 [label="0  丢弃",      shape=box, style=filled, fillcolor="#dbeafe"];
        r1 [label="1  保留",      shape=box, style=filled, fillcolor="#dbeafe"];
        r2 [label="2  丢弃 + cn", shape=box, style=filled, fillcolor="#dbeafe"];
        r3 [label="3  保留 + cn", shape=box, style=filled, fillcolor="#dbeafe"];
    }

    split [label="bpf_prog_run_array_cg()  cgroup.c:81-87\nbit0 = 保留(1)/丢弃(0)\nbit1 = cn 标志\n丢弃 -> retval = -EPERM",
           shape=note, style=filled, fillcolor="#dcfce7"];

    subgraph cluster_xmit {
        label="内核转换为 NET_XMIT_*（出站分支，cgroup.c:1604-1610）";
        fontname="Noto Sans CJK SC";
        style=filled;
        color="#fef3c7";
        x_succ [label="NET_XMIT_SUCCESS = 0\n发送",       shape=box, style=filled, fillcolor="#fef3c7"];
        x_cn   [label="NET_XMIT_CN = 2\n发送 + cn",       shape=box, style=filled, fillcolor="#fef3c7"];
        x_drop [label="NET_XMIT_DROP = 1\n丢弃 + cn",          shape=box, style=filled, fillcolor="#fee2e2"];
        x_err  [label="-EPERM (负值)\n丢弃，无 cn",        shape=box, style=filled, fillcolor="#fee2e2"];
    }

    r0 -> split;
    r1 -> split;
    r2 -> split;
    r3 -> split;

    split -> x_err  [label="ret 0（丢弃）"];
    split -> x_succ [label="ret 1（保留）"];
    split -> x_drop [label="ret 2（丢弃+cn）"];
    split -> x_cn   [label="ret 3（保留+cn）"];

    trap [label="数值空间陷阱：NET_XMIT_* 上的整数标签\n与程序的 0-3 返回值属于不同的空间。\n返回 2 会落到 NET_XMIT_DROP，而不是 NET_XMIT_CN。",
          shape=note, style=filled, fillcolor="#e9d5ff", fontname="Noto Sans CJK SC"];
    x_drop -> trap [style=dashed, arrowhead=none];
}
