digraph lpm_key_layout {
    rankdir=TB;
    labelloc=t;
    label="LPM trie 键布局：一个 u32 prefixlen 头部，后接网络字节序的地址字节";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    nodesep=0.4; ranksep=0.7;

    ipv4 [shape=plaintext, fontname="Noto Sans CJK SC", label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR>
          <TD BGCOLOR="#dbeafe">字节 0</TD><TD BGCOLOR="#dbeafe">字节 1</TD>
          <TD BGCOLOR="#dbeafe">字节 2</TD><TD BGCOLOR="#dbeafe">字节 3</TD>
          <TD BGCOLOR="#fef3c7">字节 4</TD><TD BGCOLOR="#fef3c7">字节 5</TD>
          <TD BGCOLOR="#fef3c7">字节 6</TD><TD BGCOLOR="#fef3c7">字节 7</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#dbeafe" COLSPAN="4">prefixlen（u32，在 x86 上为小端序）</TD>
          <TD BGCOLOR="#fef3c7" COLSPAN="4">addr（网络序 / 大端序）</TD>
        </TR>
        <TR>
          <TD COLSPAN="4">offsetof(data) = 4</TD>
          <TD COLSPAN="4">data_size = 4 &#8658; max_prefixlen = 32</TD>
        </TR>
      </TABLE>>];

    label4 [shape=box, style="filled,rounded", fillcolor="#e9d5ff", fontname="Noto Sans CJK SC", fontsize=10,
            label="IPv4 键：struct { __u32 prefixlen; __u32 addr; }  — key_size = 8"];

    ipv6 [shape=plaintext, fontname="Noto Sans CJK SC", label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR>
          <TD BGCOLOR="#dbeafe">0</TD><TD BGCOLOR="#dbeafe">1</TD>
          <TD BGCOLOR="#dbeafe">2</TD><TD BGCOLOR="#dbeafe">3</TD>
          <TD BGCOLOR="#fef3c7">4</TD><TD BGCOLOR="#fef3c7">..</TD>
          <TD BGCOLOR="#fef3c7">..</TD><TD BGCOLOR="#fef3c7">19</TD>
        </TR>
        <TR>
          <TD BGCOLOR="#dbeafe" COLSPAN="4">prefixlen（u32）</TD>
          <TD BGCOLOR="#fef3c7" COLSPAN="4">addr：in6_addr — 字节 4..19（16 字节）</TD>
        </TR>
        <TR>
          <TD COLSPAN="4">offsetof(data) = 4</TD>
          <TD COLSPAN="4">data_size = 16 &#8658; max_prefixlen = 128</TD>
        </TR>
      </TABLE>>];

    label6 [shape=box, style="filled,rounded", fillcolor="#e9d5ff", fontname="Noto Sans CJK SC", fontsize=10,
            label="IPv6 键：将 data[] 扩展到 16 字节 — key_size = 20，其余参数由内核推导"];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9, fontname="Noto Sans CJK SC",
          label="trie->data_size  = key_size - offsetof(...data)\ltrie->max_prefixlen = data_size * 8\l\l宽度无需配置——传入更大的 key_size，\l由内核完成计算。\l"];

    label4 -> ipv4 [style=invis];
    ipv4 -> label6 [style=invis];
    label6 -> ipv6 [style=invis];
    ipv6 -> note [style=invis];
}
