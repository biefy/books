digraph kretprobe_return_swap {
    rankdir=TB;
    labelloc=t;
    label="kretprobe：进入时替换保存的返回地址，返回时将其恢复";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC"];
    nodesep=0.5; ranksep=0.7;
    compound=true;

    // ---- Entry: the stack frame and the swap ----
    subgraph cluster_entry {
        label="函数进入时（运行 kprobe 处理程序）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";

        stack_before [shape=record, style="filled", fillcolor="#fef3c7",
            label="内核栈（替换前）|返回地址槽 = 真实调用方地址|局部变量 ...|参数 ..."];

        stack_after [shape=record, style="filled", fillcolor="#fef3c7",
            label="内核栈（替换后）|返回地址槽 = 跳板地址|局部变量 ...|参数 ..."];

        stack_before -> stack_after [label="覆盖地址槽", color="#dc2626",
            style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    }

    // ---- The instance pool ----
    subgraph cluster_pool {
        label="包含 N 个实例对象的固定池（maxactive）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#7c3aed";

        pool [shape=record, style="filled", fillcolor="#e9d5ff", fontname="Noto Sans Mono CJK SC",
            label="<i0>inst[0]：保存的真实调用方|<i1>inst[1]：保存的真实调用方|<i2>inst[2]：... |<in>inst[N-1]：空闲？"];
    }

    stack_after -> pool:i0 [label="将真实调用方复制到空闲槽", color="#7c3aed", style=bold,
        fontname="Noto Sans CJK SC", fontsize=9, lhead=cluster_pool];

    // ---- Return path ----
    subgraph cluster_return {
        label="函数返回时";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#d97706";

        pop [shape=box, style="filled,rounded", fillcolor="#dbeafe",
            label="ret 弹出跳板地址\n（不是真实调用方）"];
        tramp [shape=box, style="filled,rounded", fillcolor="#e9d5ff",
            label="arch_rethook_trampoline\n运行返回处理程序 -> 读取 RC"];
        back [shape=box, style="filled,rounded", fillcolor="#dcfce7",
            label="跳回保存的真实\n调用方地址（来自实例）"];

        pop -> tramp -> back;
    }

    pool -> pop [label="函数执行 ret", color="#d97706", style=bold,
        fontname="Noto Sans CJK SC", fontsize=9, ltail=cluster_pool];
    pool:in -> back [label="恢复保存的地址", color="#7c3aed", style=dashed,
        fontname="Noto Sans CJK SC", fontsize=9];

    // ---- Exhaustion warning ----
    missed [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
        label="突发调用：全部 N 个实例都在使用。\l新调用发现池已空，\l因此不会探测其返回：\lnmissed++，然后继续。\l"];
    pool -> missed [label="池耗尽", color="#dc2626", style=bold,
        fontname="Noto Sans CJK SC", fontsize=9];
}
