digraph cgroup_hierarchy {
    rankdir=TB;
    labelloc=t;
    label="cgroup v2 统一树：ancestors[] 按层级索引，在第 1 层匹配";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC"];

    root [shape=record, style="filled", fillcolor="#dbeafe",
          label="/sys/fs/cgroup  （根）|level = 0|kn-\>id = 1"];

    prio [shape=record, style="filled", fillcolor="#e9d5ff",
          label="/priority|level = 1|kn-\>id = 12046204  ← priority_cgroup_id"];

    work [shape=record, style="filled", fillcolor="#dbeafe",
          label="/priority/work|level = 2|kn-\>id = 12046290"];

    task [shape=note, style="filled", fillcolor="#fef3c7", fontsize=10,
          label="任务 p\l（scx_bpf_task_cgroup(p)\l 返回此 cgroup）\l"];

    root -> prio [label="子级"];
    prio -> work [label="子级"];
    work -> task [style=dashed, color="#92400e", label="属于"];

    anc [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
         label="owned = /priority/work  （第 2 层）\lbpf_for(lvl, 0, owned-\>level + 1):\l  lvl 0: ancestors[0] = root        不匹配\l  lvl 1: ancestors[1] = /priority   匹配 ✓\l  lvl 2: ancestors[2] = /priority/work\lbpf_cgroup_ancestor(owned, lvl) = O(1) 索引\l"];

    task -> anc [style=invis];
}
