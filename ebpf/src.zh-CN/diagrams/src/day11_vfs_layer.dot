digraph vfs_layer {
    rankdir=TB;
    labelloc=t;
    label="kprobe.multi/vfs_* 覆盖共享的文件系统瓶颈层";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    // 顶部：系统调用
    subgraph cluster_sys {
        label="系统调用";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        rank=same;
        s_read [shape=box, style="filled,rounded", fillcolor="#dbeafe", label="read()"];
        s_write [shape=box, style="filled,rounded", fillcolor="#dbeafe", label="write()"];
        s_open [shape=box, style="filled,rounded", fillcolor="#dbeafe", label="open()"];
        s_close [shape=box, style="filled,rounded", fillcolor="#dbeafe", label="close()"];
    }

    // 中部：VFS（突出显示）
    subgraph cluster_vfs {
        label="VFS 层  <-- 与具体文件系统无关的瓶颈层";
        fontname="Noto Sans CJK SC"; fontsize=12; style="rounded,filled";
        fillcolor="#fef3c7"; color="#d97706";
        rank=same;
        v_read [shape=box, style="filled", fillcolor="#fde68a", label="vfs_read"];
        v_write [shape=box, style="filled", fillcolor="#fde68a", label="vfs_write"];
        v_open [shape=box, style="filled", fillcolor="#fde68a", label="vfs_open"];
        v_close [shape=box, style="filled", fillcolor="#fde68a", label="vfs_close"];
    }

    // 底部：具体文件系统
    subgraph cluster_fs {
        label="具体文件系统";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#16a34a";
        rank=same;
        ext4 [shape=box, style="filled", fillcolor="#dcfce7", label="ext4"];
        xfs [shape=box, style="filled", fillcolor="#dcfce7", label="xfs"];
        btrfs [shape=box, style="filled", fillcolor="#dcfce7", label="btrfs"];
        tmpfs [shape=box, style="filled", fillcolor="#dcfce7", label="tmpfs"];
    }

    s_read -> v_read;
    s_write -> v_write;
    s_open -> v_open;
    s_close -> v_close;

    v_read -> ext4;
    v_write -> xfs;
    v_open -> btrfs;
    v_close -> tmpfs;
    v_read -> xfs [style=dotted];
    v_open -> tmpfs [style=dotted];

    bracket [shape=note, style="filled", fillcolor="#e9d5ff", fontname="Noto Sans CJK SC", fontsize=10,
             label="kprobe.multi/vfs_*\l只覆盖中间层——\l无论每个文件由哪个文件系统承载，\l都能捕获全部文件系统活动。\l"];
    bracket -> v_read [style=dashed, color=gray];
}
