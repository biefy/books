digraph verify_once {
    rankdir=TB;
    labelloc=t;
    label="内联展开验证 N 份副本；bpf_loop 只验证一次回调函数";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    subgraph cluster_inline {
        label="内联  for (i=0; i<10000; i++)";
        fontname="Noto Sans CJK SC"; fontsize=11;
        style="filled"; fillcolor="#fef2f2"; color="#dc2626";

        c0 [shape=box, style="filled", fillcolor="#dbeafe", label="副本 0：循环体"];
        c1 [shape=box, style="filled", fillcolor="#dbeafe", label="副本 1：循环体"];
        c2 [shape=box, style="filled", fillcolor="#dbeafe", label="副本 2：循环体"];
        cd [shape=box, style="filled", fillcolor="#fee2e2", label="... 还有 9997 份副本 ..."];
        cN [shape=box, style="filled", fillcolor="#dbeafe", label="副本 9999：循环体"];
        c0 -> c1 -> c2 -> cd -> cN [color="#dc2626"];

        inote [shape=note, style="filled", fillcolor="#fee2e2", fontsize=9,
            label="验证器成本随 N 增长\l已处理的指令数呈非线性增长\l-> 1M 预算 / 8192 跳转序列上限\l"];
        cN -> inote [style=invis];
    }

    subgraph cluster_loop {
        label="bpf_loop(10000, cb, &c, 0)";
        fontname="Noto Sans CJK SC"; fontsize=11;
        style="filled"; fillcolor="#f0fdf4"; color="#16a34a";

        stack [shape=record, style="filled", fillcolor="#fef3c7",
            label="栈帧 (fp)|struct cb_ctx c = \{ .s = s \}|&c  =  ARG_PTR_TO_STACK_OR_NULL"];

        cb [shape=box, style="filled", fillcolor="#dbeafe",
            label="只遍历一次回调函数（ARG_PTR_TO_FUNC）\lcb(i, ctx)，其中 i = scalar [0, nr_loops)\lset_loop_callback_state (verifier.c:9661)\l返回时 R0 必须位于 [0, 1]\l"];

        kloop [shape=box, style="filled", fillcolor="#dcfce7",
            label="运行时内核 for 循环（bpf_iter.c:743）\lfor (i=0; i<nr_loops; i++)\l  ret = callback(i, ctx, 0,0,0)\l  if (ret) return i+1\l"];

        stack -> cb [label="ctx 参数 = &c", color="#7c3aed", fontsize=9, fontname="Noto Sans CJK SC"];
        cb -> kloop [label="运行时执行 N 次（不重新验证）", style=dashed, color="#16a34a", fontsize=9, fontname="Noto Sans CJK SC"];

        lnote [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
            label="验证器成本与 N 无关\l在 7.1 内核上约为 24 条指令\l"];
        kloop -> lnote [style=invis];
    }
}
