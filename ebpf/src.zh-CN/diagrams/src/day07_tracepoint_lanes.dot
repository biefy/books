digraph tracepoint_lanes {
    rankdir=TB;
    labelloc=t;
    label="从同一 sched_switch 位置通往 BPF 的三条通道";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans CJK SC", fontsize=10];
    edge [fontname="Noto Sans CJK SC"];
    nodesep=0.5; ranksep=0.7;

    site [shape=box, style="filled,rounded", fillcolor="#e9d5ff", fontname="Noto Sans Mono CJK SC",
          label="sched_switch 跟踪点位置\n(TP_PROTO: bool preempt,\nstruct task_struct *prev, *next)"];

    fmt [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
         label="/sys/.../sched_switch/format\l声明通道 A 的模式：\lprev_comm[], prev_pid, next_comm...\l"];

    // Lane A: regular tracepoint - copied struct
    subgraph cluster_a {
        label="通道 A — tracepoint（内核复制字段）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#2563eb";
        a_ctx [shape=box, style="filled", fillcolor="#dbeafe", fontname="Noto Sans Mono CJK SC",
               label="struct trace_event_raw_sched_switch *\nchar prev_comm[16]（可读）\nint prev_pid\nchar next_comm[16]\n没有 task_struct 指针"];
        a_use [shape=box, style="filled,rounded", fillcolor="#fef3c7", fontname="Noto Sans Mono CJK SC",
               label="ctx->prev_comm\n复制的字节，可直接读取"];
        a_ctx -> a_use;
    }

    // Lane B: raw tracepoint - positional u64
    subgraph cluster_b {
        label="通道 B — raw_tracepoint（不复制）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#d97706";
        b_ctx [shape=box, style="filled", fillcolor="#fef3c7", fontname="Noto Sans Mono CJK SC",
               label="struct bpf_raw_tracepoint_args\nargs[0] = preempt (u64)\nargs[1] = prev (u64，手动转换)\nargs[2] = next (u64)"];
        b_use [shape=box, style="filled,rounded", fillcolor="#fee2e2", fontname="Noto Sans Mono CJK SC",
               label="(task_struct *)ctx->args[1]\n不可信：按位置转换"];
        b_ctx -> b_use;
    }

    // Lane C: tp_btf - typed pointers
    subgraph cluster_c {
        label="通道 C — tp_btf（同一 args[]，由 BTF 确定类型）";
        fontname="Noto Sans CJK SC"; fontsize=11; style="rounded"; color="#16a34a";
        c_ctx [shape=box, style="filled", fillcolor="#dcfce7", fontname="Noto Sans Mono CJK SC",
               label="同一原始 args[]，但由 BTF 确定类型\nargs[1] = struct task_struct *\n标记为 PTR_TO_BTF_ID"];
        c_use [shape=box, style="filled,rounded", fillcolor="#dbeafe", fontname="Noto Sans Mono CJK SC",
               label="prev->comm\n直接解引用（可信）"];
        c_ctx -> c_use;
    }

    site -> a_ctx [label="复制", color="#2563eb", style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    site -> b_ctx [label="原始 u64", color="#d97706", style=bold, fontname="Noto Sans CJK SC", fontsize=9];
    site -> c_ctx [label="原始参数 + BTF", color="#16a34a", style=bold, fontname="Noto Sans CJK SC", fontsize=9];

    fmt -> a_ctx [label="模式", color="#7c3aed", style=dashed, fontname="Noto Sans CJK SC", fontsize=9];
    a_use -> b_ctx -> c_ctx [style=invis, weight=100];
}
