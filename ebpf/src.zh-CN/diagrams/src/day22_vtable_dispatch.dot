digraph vtable_dispatch {
    rankdir=TB;
    labelloc=t;
    label="一个调用点，多个目标：icsk_ca_ops->ssthresh(sk) 通过表指针分派";
    fontname="Noto Sans CJK SC"; fontsize=14;
    node [fontname="Noto Sans Mono CJK SC", fontsize=10];

    sock [shape=record, style="filled", fillcolor="#dbeafe",
          label="struct sock / inet_connection_sock|icsk_ca_ops  ●（一个指针）"];

    callsite [shape=box, style="filled,rounded", fillcolor="#e9d5ff", fontsize=10,
              label="调用点（从不改变）\nicsk->icsk_ca_ops->ssthresh(sk)\nnet/ipv4/tcp_input.c:2570"];

    // The vtable the pointer currently targets
    vtable [shape=record, style="filled", fillcolor="#fef3c7",
            label="struct tcp_congestion_ops（虚函数表）|ssthresh   ● |cong_avoid ● |undo_cwnd  ● |init       ● |name = \"...\""];

    cubic [shape=box, style="filled", fillcolor="#dcfce7", fontsize=10,
           label="内核 C 函数\ncubictcp_recalc_ssthresh()\n（表 = CUBIC）"];

    bpf [shape=box, style="filled", fillcolor="#dcfce7", fontsize=10,
         label="BPF 程序 FD\ndctcp_ssthresh (struct_ops)\n（表 = bpf_dctcp）"];

    sock -> vtable [label="icsk_ca_ops 指向", color="#dc2626", style=bold, fontname="Noto Sans CJK SC"];
    callsite -> vtable [label="加载 ssthresh 槽位", style=dashed, color="#2563eb", fontname="Noto Sans CJK SC"];

    vtable -> cubic [label="如果指向 CUBIC 的表", color="#7c3aed", style=bold, fontname="Noto Sans CJK SC"];
    vtable -> bpf [label="或者指向 bpf_dctcp 的表", color="#7c3aed", style=bold, fontname="Noto Sans CJK SC"];

    note [shape=note, style="filled", fillcolor="#dcfce7", fontsize=9,
          label="通过每个对象的表指针先解引用再调用，这就是其中的关键。\l让 icsk_ca_ops 改为指向另一张表，就会运行不同的实现。\lstruct_ops 正是在这个接缝处将 BPF 接入。\l"];
    bpf -> note [style=invis];
}
